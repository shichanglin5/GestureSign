<Project>
  <PropertyGroup>
    <!-- This is a Windows-only project, disable platform compatibility warnings -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>

    <!-- Disable nullable reference type warnings for backward compatibility -->
    <NoWarn>$(NoWarn);CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8620;CS8622;CS8625;CS8629</NoWarn>
  </PropertyGroup>
</Project>
