<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:localization="clr-namespace:GestureSign.Common.Localization;assembly=GestureSign.Common"
             xmlns:converters="clr-namespace:GestureSign.ControlPanel.Converters"
             xmlns:Custom="http://metro.mahapps.com/winfx/xaml/controls"
             x:Class="GestureSign.ControlPanel.UserControls.GestureSelector"
             mc:Ignorable="d"
             Unloaded="UserControl_Unloaded"
             d:DesignHeight="300"
             d:DesignWidth="300"
             Loaded="UserControl_Loaded">
    <UserControl.Resources>
        <converters:GestureImageConverter x:Key="GestureImageConverter" />
    </UserControl.Resources>
    <StackPanel>
        <TextBlock x:Name="ExistingTextBlock"
                   TextWrapping="Wrap"
                   FontSize="14"
                   Margin="0,10,0,0"
                   Foreground="Red"
                   Visibility="Collapsed"
                   HorizontalAlignment="Center"
                   Cursor="Hand"
                   MouseLeftButtonDown="ExistingTextBlock_MouseLeftButtonDown">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="TextDecorations" Value="Underline" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <CheckBox x:Name="OverwriteExistingCheckBox"
                  Content="{localization:LocalisedText GestureDefinition.OverwriteExisting}"
                  HorizontalAlignment="Center"
                  Margin="0,4,0,0"
                  IsChecked="False"
                  Visibility="Collapsed"
                  Checked="OverwriteExistingCheckBox_Changed"
                  Unchecked="OverwriteExistingCheckBox_Changed" />
        <TextBlock x:Name="DrawGestureTextBlock"
                   FontSize="14"
                   FontWeight="Bold"
                   Margin="0,10"
                   Text="{localization:LocalisedText GestureDefinition.DrawGesture}"
                   HorizontalAlignment="Center"
                   Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Center"
                Margin="0,10,0,0">
            <Button x:Name="RedrawButton"
                Content="{localization:LocalisedText GestureDefinition.Redraw}"
                Custom:ControlsHelper.ContentCharacterCasing="Normal"
                Style="{DynamicResource SquareButtonStyle}"
                MinWidth="100"
                HorizontalAlignment="Center"
                BorderThickness="1"
                BorderBrush="{StaticResource MahApps.Brushes.Highlight}"
                Click="RedrawButton_Click"
                Focusable="False" />
            <CheckBox x:Name="DiagnosticLoggingCheckBox"
                Content="输出诊断日志"
                VerticalAlignment="Center"
                Margin="10,0,0,0"
                ToolTip="录制结束后将诊断文本写入临时诊断文件"
                Checked="DiagnosticLoggingCheckBox_Changed"
                Unchecked="DiagnosticLoggingCheckBox_Changed" />
        </StackPanel>
            <TextBlock x:Name="DiagnosticFilePathTextBlock"
                   Margin="0,8,0,0"
                   TextWrapping="Wrap"
                   FontSize="12"
                   HorizontalAlignment="Center"
                   Visibility="Collapsed" />
        <TextBlock x:Name="GestureTypeTextBlock"
                   FontSize="13"
                   FontWeight="Bold"
                   Foreground="{StaticResource MahApps.Brushes.Accent}"
                   Margin="0,6,0,0"
                   HorizontalAlignment="Center" />
        <Border MouseLeftButtonDown="imgGestureThumbnail_MouseLeftButtonDown"
                Background="Transparent">
            <Image x:Name="imgGestureThumbnail"
                   Source="{Binding CurrentGesture, ConverterParameter=65, Converter={StaticResource GestureImageConverter}, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"
                   MaxHeight="160"
                   Margin="0,10,0,0"
                   Stretch="Uniform"
                   HorizontalAlignment="Stretch" />
        </Border>
    </StackPanel>
</UserControl>
