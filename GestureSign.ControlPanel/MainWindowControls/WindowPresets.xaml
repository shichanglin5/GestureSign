<UserControl x:Class="GestureSign.ControlPanel.MainWindowControls.WindowPresets"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:localization="clr-namespace:GestureSign.Common.Localization;assembly=GestureSign.Common"
             xmlns:ui="clr-namespace:GestureSign.Common.UI;assembly=GestureSign.Common"
             mc:Ignorable="d"
             d:DesignHeight="400"
             d:DesignWidth="600"
             Initialized="UserControl_Initialized">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Panel: Preset List -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="{localization:LocalisedText WindowPresets.PresetList}"
                       FontSize="14"
                       FontWeight="Bold"
                       Margin="0,0,0,10" />

            <ListBox x:Name="PresetsListBox"
                     Grid.Row="1"
                     SelectionChanged="PresetsListBox_SelectionChanged"
                     ScrollViewer.PanningMode="VerticalOnly"
                     BorderThickness="1"
                     BorderBrush="{DynamicResource MahApps.Brushes.Gray7}"
                     AllowDrop="True"
                     PreviewMouseLeftButtonDown="PresetsListBox_PreviewMouseLeftButtonDown"
                     PreviewMouseMove="PresetsListBox_PreviewMouseMove"
                     Drop="PresetsListBox_Drop">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" Margin="5,2" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        Margin="0,10,0,0">
                <Button x:Name="AddPresetButton"
                        Style="{DynamicResource MetroCircleButtonStyle}"
                        Height="40"
                        Width="40"
                        Click="AddPreset_Click"
                        ToolTip="{localization:LocalisedText WindowPresets.AddPreset}">
                    <Rectangle Width="16"
                               Height="16">
                        <Rectangle.Fill>
                            <VisualBrush Visual="{StaticResource PlusIcon}" />
                        </Rectangle.Fill>
                    </Rectangle>
                </Button>
                <Button x:Name="DeletePresetButton"
                        Style="{DynamicResource MetroCircleButtonStyle}"
                        Height="40"
                        Width="40"
                        Margin="5,0,0,0"
                        Click="DeletePreset_Click"
                        IsEnabled="False"
                        ToolTip="{localization:LocalisedText WindowPresets.DeletePreset}">
                    <Rectangle Width="14"
                               Height="16"
                               Fill="{Binding Path=Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Button}}}">
                        <Rectangle.OpacityMask>
                            <VisualBrush Visual="{StaticResource DeleteIcon}" />
                        </Rectangle.OpacityMask>
                    </Rectangle>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Right Panel: Edit Area -->
        <Grid Grid.Column="1"
              Margin="20,0,0,0"
              x:Name="EditPanel"
              IsEnabled="False">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Preset Name -->
            <StackPanel Grid.Row="0">
                <TextBlock Text="{localization:LocalisedText WindowPresets.PresetName}"
                           FontWeight="Bold"
                           Margin="0,0,0,5" />
                <TextBox x:Name="PresetNameTextBox"
                         Height="26"
                         VerticalContentAlignment="Center" />
            </StackPanel>

            <!-- Match Conditions -->
            <StackPanel Grid.Row="1" Margin="0,15,0,0">
                <TextBlock Text="{localization:LocalisedText WindowPresets.MatchConditions}"
                           FontWeight="Bold"
                           Margin="0,0,0,5" />
            </StackPanel>

            <ui:MatchConditionList x:Name="PresetConditionList"
                                             Grid.Row="2"
                                             ShowCheckBox="True"
                                             Margin="0,5,0,0" />

            <!-- Activation Method -->
            <DockPanel Grid.Row="3" Margin="0,10,0,0">
                <TextBlock Text="{localization:LocalisedText WindowPresets.ActivationMethod}"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left" />
                <ComboBox x:Name="PresetActivationMethodComboBox"
                          Width="220"
                          Margin="10,0,0,0"
                          HorizontalAlignment="Left"
                          DockPanel.Dock="Left" />
            </DockPanel>

            <!-- Crosshair -->
            <StackPanel Grid.Row="4"
                        Orientation="Horizontal"
                        Margin="0,10,0,0">
                <ui:Crosshair x:Name="PresetCrosshair"
                                        Height="36"
                                        Width="36"
                                        CrosshairDragged="PresetCrosshair_Dragged" />
                <TextBlock Text="{localization:LocalisedText ApplicationDialog.DragCrosshair}"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0"
                           Foreground="{DynamicResource MahApps.Brushes.Gray3}" />
            </StackPanel>

            <!-- Save Button -->
            <Button x:Name="SavePresetButton"
                    Grid.Row="5"
                    Content="{localization:LocalisedText WindowPresets.SavePreset}"
                    Click="SavePreset_Click"
                    Margin="0,15,0,0"
                    Width="120"
                    Height="32"
                    HorizontalAlignment="Left" />
        </Grid>
    </Grid>
</UserControl>
