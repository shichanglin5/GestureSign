<UserControl x:Class="GestureSign.ControlPanel.MainWindowControls.Options"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
             xmlns:localization="clr-namespace:GestureSign.Common.Localization;assembly=GestureSign.Common"
             xmlns:common="clr-namespace:GestureSign.ControlPanel.Common"
             xmlns:viewModel="clr-namespace:GestureSign.ControlPanel.ViewModel"
             mc:Ignorable="d"
             Height="381"
             Width="380"
             Initialized="UserControl_Initialized">
    <ScrollViewer PanningMode="VerticalFirst">
        <StackPanel Width="450" HorizontalAlignment="Center">
            <StackPanel.Resources>
                <ResourceDictionary>
                    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
                    <Style TargetType="controls:ToggleSwitch"
                           BasedOn="{StaticResource {x:Type controls:ToggleSwitch}}">
                        <Setter Property="FontFamily"
                                Value="{StaticResource DefaultFont}" />
                        <Setter Property="Margin"
                                Value="0,10,0,0" />
                        <Setter Property="HorizontalAlignment"
                                Value="Stretch" />
                        <Setter Property="FontWeight"
                                Value="Normal" />
                        <Setter Property="FontSize"
                                Value="14" />
                        <Setter Property="HorizontalContentAlignment"
                                Value="Stretch" />
                        <Setter Property="ContentDirection"
                                Value="LeftToRight" />
                        <Setter Property="OnContent"
                                Value="{x:Null}" />
                        <Setter Property="OffContent"
                                Value="{x:Null}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type controls:ToggleSwitch}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ContentPresenter Grid.Column="0"
                                                          HorizontalAlignment="Left"
                                                          VerticalAlignment="Center"
                                                          Content="{TemplateBinding Content}"
                                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                                          ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                                          TextElement.FontFamily="{TemplateBinding FontFamily}"
                                                          TextElement.FontSize="{TemplateBinding FontSize}"
                                                          TextElement.FontWeight="{TemplateBinding FontWeight}"
                                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                                        <Grid x:Name="Switch"
                                              Grid.Column="1"
                                              Width="44"
                                              Height="20"
                                              Margin="12,5"
                                              VerticalAlignment="Center">
                                            <Rectangle x:Name="OuterBorder"
                                                       Fill="{DynamicResource MahApps.Brushes.ToggleSwitch.FillOff}"
                                                       RadiusX="10"
                                                       RadiusY="10"
                                                       Stroke="{DynamicResource MahApps.Brushes.ToggleSwitch.StrokeOff}"
                                                       StrokeThickness="2" />
                                            <Rectangle x:Name="SwitchKnobBounds"
                                                       Fill="{DynamicResource MahApps.Brushes.ToggleSwitch.FillOn}"
                                                       Opacity="0"
                                                       RadiusX="10"
                                                       RadiusY="10"
                                                       Stroke="{DynamicResource MahApps.Brushes.ToggleSwitch.StrokeOn}"
                                                       StrokeThickness="0" />
                                            <Grid x:Name="SwitchKnob"
                                                  Width="20"
                                                  Height="20"
                                                  HorizontalAlignment="Left">
                                                <Ellipse x:Name="SwitchKnobOn"
                                                         Width="10"
                                                         Height="10"
                                                         Fill="{DynamicResource MahApps.Brushes.ToggleSwitch.KnobFillOn}"
                                                         Opacity="0" />
                                                <Ellipse x:Name="SwitchKnobOff"
                                                         Width="10"
                                                         Height="10"
                                                         Fill="{DynamicResource MahApps.Brushes.ToggleSwitch.KnobFillOff}" />
                                                <Grid.RenderTransform>
                                                    <TranslateTransform x:Name="KnobTranslateTransform" />
                                                </Grid.RenderTransform>
                                            </Grid>
                                            <Thumb x:Name="SwitchThumb">
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Rectangle Fill="Transparent" />
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Grid>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsOn" Value="True">
                                            <Setter TargetName="SwitchKnobBounds" Property="Opacity" Value="1" />
                                            <Setter TargetName="OuterBorder" Property="Opacity" Value="0" />
                                            <Setter TargetName="SwitchKnobOn" Property="Opacity" Value="1" />
                                            <Setter TargetName="SwitchKnobOff" Property="Opacity" Value="0" />
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="SwitchKnob"
                                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                         To="24" Duration="0" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="SwitchKnob"
                                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                         To="0" Duration="0" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="OuterBorder" Property="Fill" Value="{DynamicResource MahApps.Brushes.ToggleSwitch.FillOffPointerOver}" />
                                            <Setter TargetName="OuterBorder" Property="Stroke" Value="{DynamicResource MahApps.Brushes.ToggleSwitch.StrokeOffPointerOver}" />
                                            <Setter TargetName="SwitchKnobBounds" Property="Fill" Value="{DynamicResource MahApps.Brushes.ToggleSwitch.FillOnPointerOver}" />
                                            <Setter TargetName="SwitchKnobBounds" Property="Stroke" Value="{DynamicResource MahApps.Brushes.ToggleSwitch.StrokeOnPointerOver}" />
                                            <Setter TargetName="SwitchKnobOff" Property="Fill" Value="{DynamicResource MahApps.Brushes.ToggleSwitch.KnobFillOffPointerOver}" />
                                            <Setter TargetName="SwitchKnobOn" Property="Fill" Value="{DynamicResource MahApps.Brushes.ToggleSwitch.KnobFillOnPointerOver}" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="OuterBorder" Property="Fill" Value="{DynamicResource MahApps.Brushes.ToggleSwitch.FillOffDisabled}" />
                                            <Setter TargetName="OuterBorder" Property="Stroke" Value="{DynamicResource MahApps.Brushes.ToggleSwitch.StrokeOffDisabled}" />
                                            <Setter TargetName="SwitchKnobBounds" Property="Fill" Value="{DynamicResource MahApps.Brushes.ToggleSwitch.FillOnDisabled}" />
                                            <Setter TargetName="SwitchKnobBounds" Property="Stroke" Value="{DynamicResource MahApps.Brushes.ToggleSwitch.StrokeOnDisabled}" />
                                            <Setter TargetName="SwitchKnobOff" Property="Fill" Value="{DynamicResource MahApps.Brushes.ToggleSwitch.KnobFillOffDisabled}" />
                                            <Setter TargetName="SwitchKnobOn" Property="Fill" Value="{DynamicResource MahApps.Brushes.ToggleSwitch.KnobFillOnDisabled}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <Style TargetType="Slider"
                           BasedOn="{StaticResource {x:Type Slider}}">
                        <Setter Property="Height"
                                Value="24" />
                        <Setter Property="Margin"
                                Value="0,5" />
                        <Setter Property="HorizontalAlignment"
                                Value="Stretch" />
                        <Setter Property="IsMoveToPointEnabled"
                                Value="True" />
                        <Setter Property="common:SliderTools.MoveToPointOnDrag"
                                Value="True" />
                    </Style>
                </ResourceDictionary>
            </StackPanel.Resources>
            <controls:ToggleSwitch x:Name="GestureTrailSwitch"
                                   Content="{localization:LocalisedText Options.GestureTrail}"
                                   Toggled="GestureTrailSwitch_Click" />
            <StackPanel Visibility="{Binding ElementName=GestureTrailSwitch,Path=IsChecked,Converter={StaticResource BooleanToVisibilityConverter}}"
                        Margin="0,10,0,0">
                <DockPanel HorizontalAlignment="Stretch">
                    <Button x:Name="btnPickColor"
                            Content="{localization:LocalisedText Options.PickColor}"
                            Click="btnPickColor_Click"
                            Margin="0,5"
                            FontSize="12"
                            FontWeight="Bold"
                            DockPanel.Dock="Left" />
                    <Button x:Name="SystemColorButton"
                            Content="{localization:LocalisedText Options.SystemColor}"
                            Margin="0,5"
                            FontSize="12"
                            Click="SystemColorButton_Click"
                            FontWeight="Bold"
                            DockPanel.Dock="Right"
                            HorizontalAlignment="Right" />
                </DockPanel>
                <Line x:Name="VisualFeedbackExample"
                      Height="30"
                      X1="0"
                      Y1="0"
                      X2="280"
                      Y2="0"
                      StrokeEndLineCap="Round"
                      StrokeStartLineCap="Round"
                      StrokeThickness="{Binding Value, ElementName=VisualFeedbackWidthSlider}"
                      Opacity="{Binding Value, ElementName=OpacitySlider}"
                      Margin="0,10,0,0"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Center" />
                <TextBlock x:Name="OpacityText"
                           HorizontalAlignment="Left"
                           TextWrapping="Wrap"
                           VerticalAlignment="Top"
                           Margin="15,5,0,3"
                           FontSize="14"
                           Text="{localization:LocalisedText Options.Opacity}" />
                <Slider x:Name="OpacitySlider"
                        ValueChanged="OpacitySlider_ValueChanged"
                        Maximum="1" />
                <TextBlock x:Name="VisualFeedbackWidthText"
                           HorizontalAlignment="Left"
                           TextWrapping="Wrap"
                           VerticalAlignment="Top"
                           Margin="15,15,5,3"
                           FontSize="14" />
                <Slider x:Name="VisualFeedbackWidthSlider"
                        Maximum="30"
                        ValueChanged="VisualFeedbackWidthSlider_ValueChanged"
                        SmallChange="1" />
                <TextBlock x:Name="MinimumFingerCountForVisualFeedbackText"
                           HorizontalAlignment="Left"
                           TextWrapping="Wrap"
                           Text="{Binding ElementName=MinimumFingerCountForVisualFeedbackSlider, Path=Value, StringFormat={localization:LocalisedText Options.MinimumFingerCountForVisualFeedback}}"
                           VerticalAlignment="Top"
                           Margin="15,15,5,3"
                           FontSize="14" />
                <Slider x:Name="MinimumFingerCountForVisualFeedbackSlider"
                        Maximum="5"
                        Minimum="1"
                        ValueChanged="MinimumFingerCountForVisualFeedbackSlider_ValueChanged"
                        SmallChange="1" />
            </StackPanel>
            <TextBlock x:Name="MinimumPointDistanceText"
                       HorizontalAlignment="Left"
                       TextWrapping="Wrap"
                       Text="{Binding ElementName=MinimumPointDistanceSlider, Path=Value, StringFormat={localization:LocalisedText Options.MinimumPointDistance}}"
                       VerticalAlignment="Top"
                       Margin="15,15,5,3"
                       FontSize="14" />
            <Slider x:Name="MinimumPointDistanceSlider"
                    Maximum="100"
                    Minimum="3"
                    ValueChanged="MinimumPointDistanceSlider_ValueChanged" />
            <TextBlock x:Name="TapDistanceThresholdText"
                       HorizontalAlignment="Left"
                       TextWrapping="Wrap"
                       Text="{Binding ElementName=TapDistanceThresholdSlider, Path=Value, StringFormat={localization:LocalisedText Options.TapDistanceThreshold}}"
                       VerticalAlignment="Top"
                       Margin="15,15,5,3"
                       FontSize="14" />
            <Slider x:Name="TapDistanceThresholdSlider"
                    Maximum="100"
                    Minimum="10"
                    SmallChange="5"
                    IsSnapToTickEnabled="True"
                    TickFrequency="5"
                    ValueChanged="TapDistanceThresholdSlider_ValueChanged" />
            <TextBlock x:Name="GestureMatchProbabilityText"
                       HorizontalAlignment="Left"
                       TextWrapping="Wrap"
                       Text="{Binding ElementName=GestureMatchProbabilitySlider, Path=Value, StringFormat={localization:LocalisedText Options.GestureMatchProbability}}"
                       VerticalAlignment="Top"
                       Margin="15,15,5,3"
                       FontSize="14" />
            <Slider x:Name="GestureMatchProbabilitySlider"
                    Maximum="95"
                    Minimum="50"
                    SmallChange="1"
                    IsSnapToTickEnabled="True"
                    TickFrequency="1"
                    ValueChanged="GestureMatchProbabilitySlider_ValueChanged" />
            <TextBlock x:Name="MultiFingerDelayText"
                       HorizontalAlignment="Left"
                       TextWrapping="Wrap"
                       Text="{Binding ElementName=MultiFingerDelaySlider, Path=Value, StringFormat={localization:LocalisedText Options.MultiFingerDelay}}"
                       VerticalAlignment="Top"
                       Margin="15,15,5,3"
                       FontSize="14" />
            <Slider x:Name="MultiFingerDelaySlider"
                    Maximum="200"
                    Minimum="0"
                    SmallChange="10"
                    IsSnapToTickEnabled="True"
                    TickFrequency="10"
                    ValueChanged="MultiFingerDelaySlider_ValueChanged" />
            <TextBlock Text="{localization:LocalisedText Options.Language}"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"
                       FontSize="14"
                       Margin="0,20,0,5" />
            <ComboBox x:Name="LanguageComboBox"
                      HorizontalAlignment="Stretch"
                      FontSize="14"
                      Margin="0,5"
                      DisplayMemberPath="Value"
                      SelectedValuePath="Key"
                      DropDownClosed="LanguageComboBox_DropDownClosed" />
            <controls:ToggleSwitch x:Name="TouchScreenSwitch"
                                   Toggled="TouchScreenSwitch_Click">
                <controls:ToggleSwitch.Content>
                    <TextBlock FontSize="14"
                               FontWeight="Normal">
                        <Run Text="{localization:LocalisedText Options.TouchScreen}" />
                        <Run Name="TouchScreenNotFoundText"
                             Foreground="{StaticResource MahApps.Brushes.Accent}"
                             Text="{localization:LocalisedText Options.DeviceNotFound}" />
                    </TextBlock>
                </controls:ToggleSwitch.Content>
            </controls:ToggleSwitch>
            <controls:ToggleSwitch x:Name="TouchPadSwitch"
                                   Toggled="TouchPadSwitch_Click">
                <controls:ToggleSwitch.Content>
                    <TextBlock FontSize="14"
                               FontWeight="Normal">
                        <Run Text="{localization:LocalisedText Options.TouchPad}" />
                        <Run Name="TouchPadNotFoundText"
                             Foreground="{StaticResource MahApps.Brushes.Accent}"
                             Text="{localization:LocalisedText Options.DeviceNotFound}" />
                    </TextBlock>
                </controls:ToggleSwitch.Content>
            </controls:ToggleSwitch>

            <!-- 焦点窗口规则标题 -->
            <TextBlock Text="{localization:LocalisedText Options.WindowTargetRuleTitle}"
                       FontSize="16"
                       FontWeight="Bold"
                       Margin="0,20,0,10"
                       HorizontalAlignment="Left" />

            <!-- 触摸板窗口目标模式 -->
            <TextBlock Text="{localization:LocalisedText Options.TouchPadWindowTarget}"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"
                       FontSize="14"
                       Margin="0,10,0,5" />
            <ComboBox x:Name="TouchPadWindowTargetComboBox"
                      HorizontalAlignment="Stretch"
                      FontSize="14"
                      Margin="0,5,0,0"
                      SelectionChanged="TouchPadWindowTargetComboBox_SelectionChanged">
                <ComboBoxItem Content="{localization:LocalisedText Options.WindowTargetMousePosition}" Tag="0" />
                <ComboBoxItem Content="{localization:LocalisedText Options.WindowTargetActiveWindow}" Tag="1" />
                <ComboBoxItem Content="{localization:LocalisedText Options.WindowTargetGestureStart}" Tag="2" />
            </ComboBox>

            <!-- 触摸屏窗口目标模式 -->
            <TextBlock Text="{localization:LocalisedText Options.TouchScreenWindowTarget}"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"
                       FontSize="14"
                       Margin="0,15,0,5" />
            <ComboBox x:Name="TouchScreenWindowTargetComboBox"
                      HorizontalAlignment="Stretch"
                      FontSize="14"
                      Margin="0,5,0,0"
                      SelectionChanged="TouchScreenWindowTargetComboBox_SelectionChanged">
                <ComboBoxItem Content="{localization:LocalisedText Options.WindowTargetMousePosition}" Tag="0" />
                <ComboBoxItem Content="{localization:LocalisedText Options.WindowTargetActiveWindow}" Tag="1" />
                <ComboBoxItem Content="{localization:LocalisedText Options.WindowTargetGestureStart}" Tag="2" />
            </ComboBox>

            <TextBlock Text="{localization:LocalisedText Options.GlobalActivationMethod}"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"
                       FontSize="14"
                       Margin="0,15,0,5" />
            <ComboBox x:Name="GlobalActivationMethodComboBox"
                      HorizontalAlignment="Stretch"
                      FontSize="14"
                      Margin="0,5,0,10"
                      SelectionChanged="GlobalActivationMethodComboBox_SelectionChanged">
                <ComboBoxItem Content="{localization:LocalisedText Options.GlobalActivationMethodAttachThreadInput}" Tag="1" />
                <ComboBoxItem Content="{localization:LocalisedText Options.GlobalActivationMethodSafeMode}" Tag="2" />
            </ComboBox>

            <CheckBox x:Name="ReFetchTargetWindowCheckBox"
                      Content="{localization:LocalisedText Options.ReFetchTargetWindowOnExecution}"
                      HorizontalAlignment="Left"
                      FontSize="14"
                      Margin="0,10,0,0"
                      Checked="ReFetchTargetWindowCheckBox_Changed"
                      Unchecked="ReFetchTargetWindowCheckBox_Changed" />

            <controls:ToggleSwitch x:Name="InitialTimeoutSwitch"
                                   Content="{localization:LocalisedText Options.InitialTimeoutTitle}"
                                   Toggled="InitialTimeoutSwitch_Click" />
            <TextBlock HorizontalAlignment="Left"
                       Visibility="{Binding ElementName=InitialTimeoutSwitch,Path=IsChecked,Converter={StaticResource BooleanToVisibilityConverter}}"
                       Text="{Binding ElementName=InitialTimeoutSlider, Path=Value, StringFormat={localization:LocalisedText Options.InitialTimeout}}"
                       FontSize="14"
                       Margin="0,5,0,0" />
            <Slider x:Name="InitialTimeoutSlider"
                    Visibility="{Binding ElementName=InitialTimeoutSwitch,Path=IsChecked,Converter={StaticResource BooleanToVisibilityConverter}}"
                    Maximum="2"
                    TickFrequency="0.1"
                    IsSnapToTickEnabled="True"
                    ValueChanged="InitialTimeoutSlider_ValueChanged" />
            <controls:ToggleSwitch x:Name="StartupSwitch"
                                   Content="{localization:LocalisedText Options.WindowsStartup.Header}"
                                   Toggled="StartupSwitch_OnClick" />
            <CheckBox x:Name="RunAsAdminCheckBox"
                      Visibility="{Binding ElementName=StartupSwitch,Path=IsChecked,Converter={StaticResource BooleanToVisibilityConverter}}"
                      Click="RunAsAdminCheckBox_Click"
                      Margin="0,10,0,0"
                      FontSize="14"
                      Content="{localization:LocalisedText Options.RunAsAdmin}"
                      HorizontalAlignment="Left" />
            <controls:ToggleSwitch x:Name="IgnoreFullScreenSwitch"
                                   Content="{localization:LocalisedText Options.IgnoreFullScreen.Header}"
                                   Toggled="IgnoreFullScreenSwitch_Click" />
            <controls:ToggleSwitch x:Name="BlockWindowsGesturesSwitch"
                                   Content="{localization:LocalisedText Options.BlockWindowsGestures.Header}"
                                   Toggled="BlockWindowsGesturesSwitch_Click" />
            <controls:ToggleSwitch x:Name="ShowTrayIconSwitch"
                                   Content="{localization:LocalisedText Options.ShowTrayIconSwitch.Header}"
                                   Toggled="ShowTrayIconSwitch_Toggled" />
            <controls:ToggleSwitch x:Name="SendLogToggleSwitch"
                                   Content="{localization:LocalisedText Options.ErrorLogPrompt}"
                                   Toggled="SendLogToggleSwitch_Toggled" />
            <TextBlock Text="{localization:LocalisedText Options.LogLevel}"
                       FontSize="16"
                       FontWeight="Bold"
                       Margin="0,10,0,5" />
            <ComboBox x:Name="LogLevelComboBox"
                      SelectionChanged="LogLevelComboBox_SelectionChanged"
                      Margin="0,0,0,10">
                <ComboBoxItem Content="{localization:LocalisedText Options.LogLevelError}" Tag="0" />
                <ComboBoxItem Content="{localization:LocalisedText Options.LogLevelWarning}" Tag="1" />
                <ComboBoxItem Content="{localization:LocalisedText Options.LogLevelInfo}" Tag="2" />
                <ComboBoxItem Content="{localization:LocalisedText Options.LogLevelDebug}" Tag="3" />
                <ComboBoxItem Content="{localization:LocalisedText Options.LogLevelTrace}" Tag="4" />
            </ComboBox>
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,20,0,10">
                <Button x:Name="BackupButton"
                        Content="{localization:LocalisedText Options.Backup}"
                        FontSize="12"
                        FontWeight="Bold"
                        Click="BackupButton_Click" />
                <Button x:Name="RestoreButton"
                        Margin="20,0,0,0"
                        Content="{localization:LocalisedText Options.Restore}"
                        FontSize="12"
                        FontWeight="Bold"
                        Click="RestoreButton_Click" />
                <Button x:Name="OpenConfigFolderButton"
                        Margin="20,0,0,0"
                        Content="{localization:LocalisedText Options.OpenConfigFolder}"
                        FontSize="12"
                        FontWeight="Bold"
                        Click="OpenConfigFolderButton_Click" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
