<controls:MetroWindow x:Class="GestureSign.ControlPanel.Dialogs.InheritConfigDialog"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls"
                      xmlns:localization="clr-namespace:GestureSign.Common.Localization;assembly=GestureSign.Common"
                      Title="{localization:LocalisedText ContinuousGesture.InheritTitle}"
                      Width="300"
                      SizeToContent="Height"
                      FlowDirection="{StaticResource DefaultFlowDirection}"
                      BorderBrush="{StaticResource MahApps.Brushes.Accent}"
                      BorderThickness="1"
                      ResizeMode="NoResize"
                      WindowStartupLocation="CenterScreen">
    <StackPanel Margin="15">
        <TextBlock Text="{localization:LocalisedText ContinuousGesture.InheritDescription}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10"
                   FontSize="13" />
        <CheckBox x:Name="Inherit2Finger"
                  Content="{localization:LocalisedText ContinuousGesture.Inherit2Finger}"
                  FontSize="14"
                  Margin="0,3" />
        <CheckBox x:Name="Inherit3Finger"
                  Content="{localization:LocalisedText ContinuousGesture.Inherit3Finger}"
                  FontSize="14"
                  Margin="0,3" />
        <CheckBox x:Name="Inherit4Finger"
                  Content="{localization:LocalisedText ContinuousGesture.Inherit4Finger}"
                  FontSize="14"
                  Margin="0,3" />
        <Grid Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Content="{localization:LocalisedText Common.Cancel}"
                    FontSize="14"
                    IsCancel="True"
                    Grid.Column="0" />
            <Button Content="{localization:LocalisedText Common.OK}"
                    FontSize="14"
                    IsDefault="True"
                    Click="OkButton_Click"
                    Grid.Column="1" />
        </Grid>
    </StackPanel>
</controls:MetroWindow>
