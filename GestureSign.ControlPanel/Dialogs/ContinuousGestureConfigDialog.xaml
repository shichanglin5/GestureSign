<controls:MetroWindow x:Class="GestureSign.ControlPanel.Dialogs.ContinuousGestureConfigDialog"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls"
                      xmlns:localization="clr-namespace:GestureSign.Common.Localization;assembly=GestureSign.Common"
                      Title="{localization:LocalisedText ContinuousGesture.ConfigTitle}"
                      Width="400"
                      SizeToContent="Height"
                      FlowDirection="{StaticResource DefaultFlowDirection}"
                      BorderBrush="{StaticResource MahApps.Brushes.Accent}"
                      BorderThickness="1"
                      ResizeMode="NoResize"
                      WindowStartupLocation="CenterScreen">
    <StackPanel Margin="15"
                x:Name="MainPanel">
        <!-- 缩放设置 -->
        <StackPanel x:Name="ZoomSpeedPanel"
                    Margin="0,0,0,10">
            <!-- 缩放速度 -->
            <DockPanel Margin="0,0,0,5">
                <TextBlock Text="{localization:LocalisedText ContinuousGesture.ZoomSpeed}"
                           VerticalAlignment="Center"
                           Width="120"
                           FontSize="13" />
                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding ElementName=ZoomSpeedSlider,Path=Value,StringFormat={}{0:F1}}"
                           VerticalAlignment="Center"
                           Width="30"
                           TextAlignment="Right"
                           FontSize="13"
                           Margin="5,0,0,0" />
                <Slider x:Name="ZoomSpeedSlider"
                        Minimum="0.1"
                        Maximum="5.0"
                        TickFrequency="0.1"
                        IsSnapToTickEnabled="True"
                        Value="1.0"
                        VerticalAlignment="Center" />
            </DockPanel>
            <!-- 缩放灵敏度 -->
            <DockPanel Margin="0,0,0,5">
                <TextBlock Text="{localization:LocalisedText ContinuousGesture.ZoomSensitivity}"
                           VerticalAlignment="Center"
                           Width="120"
                           FontSize="13" />
                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding ElementName=ZoomSensitivitySlider,Path=Value,StringFormat={}{0:F1}}"
                           VerticalAlignment="Center"
                           Width="30"
                           TextAlignment="Right"
                           FontSize="13"
                           Margin="5,0,0,0" />
                <Slider x:Name="ZoomSensitivitySlider"
                        Minimum="0.1"
                        Maximum="3.0"
                        TickFrequency="0.1"
                        IsSnapToTickEnabled="True"
                        Value="1.0"
                        VerticalAlignment="Center" />
            </DockPanel>
        </StackPanel>

        <!-- InertialScroll 设置 -->
        <StackPanel x:Name="ScrollSettingsPanel"
                    Margin="0,0,0,10">
            <TextBlock Text="{localization:LocalisedText ContinuousGesture.ScrollSettings}"
                       FontSize="14"
                       FontWeight="Bold"
                       Margin="0,0,0,8" />

            <!-- 滚动方向 -->
            <DockPanel Margin="0,0,0,5">
                <TextBlock Text="{localization:LocalisedText ContinuousGesture.ScrollDirection}"
                           VerticalAlignment="Center"
                           Width="120"
                           FontSize="13" />
                <ComboBox x:Name="ScrollDirectionComboBox"
                          FontSize="12" />
            </DockPanel>

            <!-- 方向噪声比例 -->
            <DockPanel Margin="0,0,0,5">
                <TextBlock Text="{localization:LocalisedText ContinuousGesture.NoiseRatio}"
                           VerticalAlignment="Center"
                           Width="120"
                           FontSize="13" />
                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding ElementName=NoiseRatioSlider,Path=Value,StringFormat={}{0:F2}}"
                           VerticalAlignment="Center"
                           Width="30"
                           TextAlignment="Right"
                           FontSize="13"
                           Margin="5,0,0,0" />
                <Slider x:Name="NoiseRatioSlider"
                        Minimum="0.10"
                        Maximum="0.50"
                        TickFrequency="0.01"
                        IsSnapToTickEnabled="True"
                        Value="0.25"
                        VerticalAlignment="Center" />
            </DockPanel>

                        <DockPanel Margin="0,0,0,5">
                                <TextBlock Text="{localization:LocalisedText ContinuousGesture.LockExitMinorDistance}"
                                                   VerticalAlignment="Center"
                                                   Width="120"
                                                   FontSize="13" />
                                <TextBlock DockPanel.Dock="Right"
                                                   Text="{Binding ElementName=LockExitMinorDistanceSlider,Path=Value,StringFormat={}{0:F0}}"
                                                   VerticalAlignment="Center"
                                                   Width="30"
                                                   TextAlignment="Right"
                                                   FontSize="13"
                                                   Margin="5,0,0,0" />
                                <Slider x:Name="LockExitMinorDistanceSlider"
                                                Minimum="0"
                                                Maximum="20"
                                                TickFrequency="1"
                                                IsSnapToTickEnabled="True"
                                                Value="6"
                                                VerticalAlignment="Center" />
                        </DockPanel>

                        <DockPanel Margin="0,0,0,5">
                                <TextBlock Text="{localization:LocalisedText ContinuousGesture.RelockRatioMultiplier}"
                                                   VerticalAlignment="Center"
                                                   Width="120"
                                                   FontSize="13" />
                                <TextBlock DockPanel.Dock="Right"
                                                   Text="{Binding ElementName=RelockRatioMultiplierSlider,Path=Value,StringFormat={}{0:F2}}"
                                                   VerticalAlignment="Center"
                                                   Width="30"
                                                   TextAlignment="Right"
                                                   FontSize="13"
                                                   Margin="5,0,0,0" />
                                <Slider x:Name="RelockRatioMultiplierSlider"
                                                Minimum="0.30"
                                                Maximum="1.00"
                                                TickFrequency="0.05"
                                                IsSnapToTickEnabled="True"
                                                Value="0.80"
                                                VerticalAlignment="Center" />
                        </DockPanel>

            <!-- 每滚动单位像素 -->
            <DockPanel Margin="0,0,0,5">
                <TextBlock Text="{localization:LocalisedText ContinuousGesture.PixelsPerScroll}"
                           VerticalAlignment="Center"
                           Width="120"
                           FontSize="13" />
                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding ElementName=PixelsPerScrollSlider,Path=Value,StringFormat={}{0:F0}}"
                           VerticalAlignment="Center"
                           Width="30"
                           TextAlignment="Right"
                           FontSize="13"
                           Margin="5,0,0,0" />
                <Slider x:Name="PixelsPerScrollSlider"
                        Minimum="5"
                        Maximum="200"
                        TickFrequency="5"
                        IsSnapToTickEnabled="True"
                        Value="30"
                        VerticalAlignment="Center" />
            </DockPanel>

            <!-- 加速因子 -->
            <DockPanel Margin="0,0,0,5">
                <TextBlock Text="{localization:LocalisedText ContinuousGesture.AccelerationFactor}"
                           VerticalAlignment="Center"
                           Width="120"
                           FontSize="13" />
                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding ElementName=AccelerationSlider,Path=Value,StringFormat={}{0:F1}}"
                           VerticalAlignment="Center"
                           Width="30"
                           TextAlignment="Right"
                           FontSize="13"
                           Margin="5,0,0,0" />
                <Slider x:Name="AccelerationSlider"
                        Minimum="0.1"
                        Maximum="5.0"
                        TickFrequency="0.1"
                        IsSnapToTickEnabled="True"
                        Value="1.0"
                        VerticalAlignment="Center" />
            </DockPanel>

            <!-- 反转方向 -->
            <CheckBox x:Name="ReverseDirectionCheckBox"
                      Content="{localization:LocalisedText ContinuousGesture.ReverseDirection}"
                      FontSize="13"
                      Margin="0,0,0,3" />
            <CheckBox x:Name="ReverseHorizontalCheckBox"
                      Content="{localization:LocalisedText ContinuousGesture.ReverseHorizontal}"
                      FontSize="13"
                      Margin="0,0,0,3" />

            <!-- WinUI 检测 -->
            <CheckBox x:Name="WinUIDetectionCheckBox"
                      Content="{localization:LocalisedText ContinuousGesture.WinUIDetection}"
                      FontSize="13"
                      Margin="0,0,0,8" />

            <!-- 惯性滚动设置 -->
            <TextBlock Text="{localization:LocalisedText ContinuousGesture.MomentumSettings}"
                       FontSize="14"
                       FontWeight="Bold"
                       Margin="0,0,0,8" />

            <!-- 触发惯性最大末帧静止时长 -->
            <DockPanel Margin="0,0,0,5">
                <TextBlock Text="{localization:LocalisedText ContinuousGesture.MomentumTriggerMaxIdle}"
                           VerticalAlignment="Center"
                           Width="150"
                           FontSize="13" />
                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding ElementName=MomentumTriggerMaxIdleSlider,Path=Value,StringFormat={}{0:F0}}"
                           VerticalAlignment="Center"
                           Width="40"
                           TextAlignment="Right"
                           FontSize="13"
                           Margin="5,0,0,0" />
                <Slider x:Name="MomentumTriggerMaxIdleSlider"
                        Minimum="30"
                        Maximum="300"
                        TickFrequency="10"
                        IsSnapToTickEnabled="True"
                        Value="120"
                        VerticalAlignment="Center" />
            </DockPanel>

            <CheckBox x:Name="EnableMomentumCheckBox"
                      Content="{localization:LocalisedText ContinuousGesture.EnableMomentum}"
                      FontSize="13"
                      Margin="0,0,0,5"
                      Checked="EnableMomentumCheckBox_Changed"
                      Unchecked="EnableMomentumCheckBox_Changed" />

            <StackPanel x:Name="MomentumDetailsPanel"
                        Margin="0,0,0,3">
                <!-- 衰减时间常数 -->
                <DockPanel Margin="0,0,0,5">
                    <TextBlock Text="{localization:LocalisedText ContinuousGesture.MomentumTimeConstant}"
                               VerticalAlignment="Center"
                               Width="150"
                               FontSize="13" />
                    <TextBlock DockPanel.Dock="Right"
                               Text="{Binding ElementName=MomentumTimeConstantSlider,Path=Value,StringFormat={}{0:F0}}"
                               VerticalAlignment="Center"
                               Width="40"
                               TextAlignment="Right"
                               FontSize="13"
                               Margin="5,0,0,0" />
                    <Slider x:Name="MomentumTimeConstantSlider"
                            Minimum="100"
                            Maximum="2000"
                            TickFrequency="50"
                            IsSnapToTickEnabled="True"
                            Value="600"
                            VerticalAlignment="Center" />
                </DockPanel>

                <!-- 最小速度 -->
                <DockPanel Margin="0,0,0,5">
                    <TextBlock Text="{localization:LocalisedText ContinuousGesture.MomentumMinVelocity}"
                               VerticalAlignment="Center"
                               Width="150"
                               FontSize="13" />
                    <TextBlock DockPanel.Dock="Right"
                               Text="{Binding ElementName=MomentumMinVelocitySlider,Path=Value,StringFormat={}{0:F0}}"
                               VerticalAlignment="Center"
                               Width="40"
                               TextAlignment="Right"
                               FontSize="13"
                               Margin="5,0,0,0" />
                    <Slider x:Name="MomentumMinVelocitySlider"
                            Minimum="0"
                            Maximum="1000"
                            TickFrequency="10"
                            IsSnapToTickEnabled="True"
                            Value="10"
                            VerticalAlignment="Center" />
                </DockPanel>

                <!-- 停止阈值 -->
                <DockPanel Margin="0,0,0,5">
                    <TextBlock Text="{localization:LocalisedText ContinuousGesture.MomentumStopThreshold}"
                               VerticalAlignment="Center"
                               Width="150"
                               FontSize="13" />
                    <TextBlock DockPanel.Dock="Right"
                               Text="{Binding ElementName=MomentumStopThresholdSlider,Path=Value,StringFormat={}{0:F0}}"
                               VerticalAlignment="Center"
                               Width="40"
                               TextAlignment="Right"
                               FontSize="13"
                               Margin="5,0,0,0" />
                    <Slider x:Name="MomentumStopThresholdSlider"
                            Minimum="0"
                            Maximum="2000"
                            TickFrequency="50"
                            IsSnapToTickEnabled="True"
                            Value="500"
                            VerticalAlignment="Center" />
                </DockPanel>

                <!-- 最大时长 -->
                <DockPanel Margin="0,0,0,5">
                    <TextBlock Text="{localization:LocalisedText ContinuousGesture.MomentumMaxDuration}"
                               VerticalAlignment="Center"
                               Width="150"
                               FontSize="13" />
                    <TextBlock DockPanel.Dock="Right"
                               Text="{Binding ElementName=MomentumMaxDurationSlider,Path=Value,StringFormat={}{0:F0}}"
                               VerticalAlignment="Center"
                               Width="40"
                               TextAlignment="Right"
                               FontSize="13"
                               Margin="5,0,0,0" />
                    <Slider x:Name="MomentumMaxDurationSlider"
                            Minimum="200"
                            Maximum="5000"
                            TickFrequency="100"
                            IsSnapToTickEnabled="True"
                            Value="1500"
                            VerticalAlignment="Center" />
                </DockPanel>
            </StackPanel>
        </StackPanel>

        <!-- 按钮 -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,5,0,0">
            <Button Content="{localization:LocalisedText Common.Cancel}"
                    IsCancel="True"
                    Width="80"
                    FontSize="14"
                    Margin="0,0,10,0" />
            <Button Content="{localization:LocalisedText Common.OK}"
                    Click="OkButton_Click"
                    IsDefault="True"
                    Width="80"
                    FontSize="14" />
        </StackPanel>
    </StackPanel>
</controls:MetroWindow>

