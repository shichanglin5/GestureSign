<controls:MetroWindow x:Class="GestureSign.ControlPanel.Dialogs.ActionDialog"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                      xmlns:local="clr-namespace:GestureSign.ControlPanel.Dialogs"
                      xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls"
                      xmlns:usercontrols="clr-namespace:GestureSign.ControlPanel.UserControls"
                      xmlns:localization="clr-namespace:GestureSign.Common.Localization;assembly=GestureSign.Common"
                      xmlns:viewModel="clr-namespace:GestureSign.ControlPanel.ViewModel"
                      xmlns:converters="clr-namespace:GestureSign.ControlPanel.Converters"
                      xmlns:common="clr-namespace:GestureSign.ControlPanel.Common"
                      mc:Ignorable="d"
                      Title="{localization:LocalisedText ActionDialog.EditActionTitle}"
                      FlowDirection="{StaticResource DefaultFlowDirection}"
                      BorderBrush="{StaticResource MahApps.Brushes.Accent}"
                      ResizeMode="NoResize"
                      WindowStartupLocation="CenterScreen"
                      ShowIconOnTitleBar="False"
                      SizeToContent="WidthAndHeight"
                      BorderThickness="1"
                      MaxHeight="700"
                      Width="400"
                      Loaded="MetroWindow_Loaded">
    <controls:MetroWindow.Resources>
        <ResourceDictionary>
            <converters:GestureImageConverter x:Key="GestureImageConverter" />
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </ResourceDictionary>
    </controls:MetroWindow.Resources>
    <controls:MetroWindow.Flyouts>
        <controls:FlyoutsControl>
            <controls:Flyout x:Name="MessageFlyout"
                             Theme="Accent"
                             Position="Bottom"
                             CloseButtonVisibility="Collapsed"
                             IsPinned="False"
                             Height="{Binding ElementName=MessageFlyoutText,Path=Height}">
                <TextBlock x:Name="MessageFlyoutText"
                           FontSize="16"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Margin="0,10" />
            </controls:Flyout>
        </controls:FlyoutsControl>
    </controls:MetroWindow.Flyouts>
    <StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      MaxHeight="550">
            <StackPanel>
                <!-- Gesture Section -->
                <TextBlock Text="{localization:LocalisedText Gesture.Header}"
                           FontSize="16"
                           FontWeight="Bold"
                           Margin="20,10,0,5"
                           HorizontalAlignment="Left" />
                <usercontrols:GestureSelector x:Name="GestureSelector"
                                              CurrentGesture="{Binding CurrentGesture, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type controls:MetroWindow}, Mode=FindAncestor}}"
                                              CurrentRecordedDefinition="{Binding CurrentRecordedDefinition, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type controls:MetroWindow}, Mode=FindAncestor}}"
                                              Margin="20,0,20,10" />

                <!-- Advanced Options Section -->
                <TextBlock Text="{localization:LocalisedText ActionDialog.Advanced}"
                           FontSize="16"
                           FontWeight="Bold"
                           Margin="20,10,0,10"
                           HorizontalAlignment="Left" />

                <!-- Device Limit -->
                <TextBlock Text="{localization:LocalisedText ActionDialog.DeviceLimit}"
                           FontSize="14"
                           Margin="20,10,0,0"
                           HorizontalAlignment="Left"
                           FontWeight="Bold" />
                <StackPanel Orientation="Horizontal"
                            Margin="20,10,0,0">
                    <CheckBox x:Name="TouchScreenCheckBox"
                              IsChecked="True"
                              Margin="0,0,15,0"
                              FontSize="14"
                              Content="{localization:LocalisedText ActionDialog.TouchScreen}" />
                    <CheckBox x:Name="TouchPadCheckBox"
                              IsChecked="True"
                              FontSize="14"
                              Content="{localization:LocalisedText ActionDialog.TouchPad}" />
                </StackPanel>

                <!-- Gesture Match Strategy -->
                <TextBlock x:Name="MatchStrategyLabel"
                           Text="{localization:LocalisedText ActionDialog.GestureMatchStrategy}"
                           FontSize="14"
                           Margin="20,10,0,0"
                           HorizontalAlignment="Left"
                           FontWeight="Bold"
                           Visibility="Collapsed" />
                <ComboBox x:Name="MatchStrategyComboBox"
                          FontSize="14"
                          Margin="20,5,20,0"
                          Visibility="Collapsed"
                          SelectionChanged="MatchStrategyComboBox_SelectionChanged">
                    <ComboBoxItem Content="{localization:LocalisedText ActionDialog.MatchStrategyInherit}" />
                    <ComboBoxItem Content="{localization:LocalisedText ActionDialog.MatchStrategyAllFingers}" />
                    <ComboBoxItem Content="{localization:LocalisedText ActionDialog.MatchStrategyFeatureFinger}" />
                </ComboBox>

                <!-- Gesture Modifiers -->
                <TextBlock x:Name="ModifiersLabel"
                           Text="{localization:LocalisedText ActionDialog.GestureModifiers}"
                           FontSize="14"
                           FontWeight="Bold"
                           Margin="20,10,0,0"
                           HorizontalAlignment="Left"
                           Visibility="Collapsed" />
                <StackPanel x:Name="ModifiersPanel"
                            Margin="20,5,20,5"
                            Visibility="Collapsed">
                    <CheckBox x:Name="ModPrimaryButton"
                              Content="{localization:LocalisedText ActionDialog.ModPrimaryButton}"
                              FontSize="14"
                              Margin="0,2" />
                    <CheckBox x:Name="ModCtrl"
                              Content="{localization:LocalisedText ActionDialog.ModCtrl}"
                              FontSize="14"
                              Margin="0,2" />
                    <CheckBox x:Name="ModShift"
                              Content="{localization:LocalisedText ActionDialog.ModShift}"
                              FontSize="14"
                              Margin="0,2" />
                    <CheckBox x:Name="ModAlt"
                              Content="{localization:LocalisedText ActionDialog.ModAlt}"
                              FontSize="14"
                              Margin="0,2" />
                </StackPanel>

                <!-- Activate Window -->
                <CheckBox x:Name="ActivateWindowCheckBox"
                          Margin="20,15,0,15"
                          FontSize="14"
                          HorizontalAlignment="Left"
                          Content="{localization:LocalisedText ActionDialog.ActivateWindow}" />
            </StackPanel>
        </ScrollViewer>
        <TextBlock TextWrapping="Wrap"
                   Text="{localization:LocalisedText ActionDialog.ActionName}"
                   FontWeight="Bold"
                   FontSize="14"
                   HorizontalAlignment="Left"
                   Margin="20,20,0,0" />
        <TextBox x:Name="ActionNameTextBox"
                 controls:TextBoxHelper.Watermark="{localization:LocalisedText ActionDialog.ActionNameWatermark}"
                 FontSize="14"
                 MaxLines="3"
                 MaxLength="80"
                 Margin="20,5,20,10" />
        <Grid Height="35">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="CancelButton"
                    Content="{localization:LocalisedText Common.Cancel}"
                    IsCancel="True"
                    FontSize="14" />
            <Button x:Name="OkButton"
                    Content="{localization:LocalisedText Common.OK}"
                    Click="OkButton_Click"
                    FontSize="14"
                    IsDefault="True"
                    Grid.Column="1" />
        </Grid>
    </StackPanel>
</controls:MetroWindow>

