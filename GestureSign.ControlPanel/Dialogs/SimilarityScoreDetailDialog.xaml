<controls:MetroWindow x:Class="GestureSign.ControlPanel.Dialogs.SimilarityScoreDetailDialog"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls"
                      Title="匹配评分明细"
                      Width="980"
                      Height="620"
                      MinWidth="860"
                      MinHeight="520"
                      BorderBrush="{StaticResource MahApps.Brushes.Accent}"
                      BorderThickness="1"
                      FlowDirection="{StaticResource DefaultFlowDirection}"
                      ShowIconOnTitleBar="False"
                      WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="{Binding Candidate.Name}"
                           FontSize="20"
                           FontWeight="SemiBold" />
                <TextBlock Margin="0,8,0,0"
                           Text="{Binding SummaryText}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource MahApps.Brushes.Accent}" />
            </StackPanel>

            <Button Grid.Column="2"
                    Content="关闭"
                    Width="96"
                    Height="34"
                    Click="CloseButton_Click" />
        </Grid>

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding DetailItems}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  BorderThickness="1"
                  BorderBrush="{DynamicResource MahApps.Brushes.Gray4}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="层级"
                                    Width="72"
                                    Binding="{Binding LevelText}" />
                <DataGridTextColumn Header="轨迹"
                                    Width="72"
                                    Binding="{Binding TrajectoryText}" />
                <DataGridTextColumn Header="类型"
                                    Width="96"
                                    Binding="{Binding MatchModeText}" />
                <DataGridTextColumn Header="最终分"
                                    Width="88"
                                    Binding="{Binding ProbabilityText}" />
                <DataGridTextColumn Header="角度分"
                                    Width="88"
                                    Binding="{Binding AngularProbabilityText}" />
                <DataGridTextColumn Header="平均角差"
                                    Width="96"
                                    Binding="{Binding AverageAngularDeltaText}" />
                <DataGridTextColumn Header="结构惩罚"
                                    Width="92"
                                    Binding="{Binding StructuralPenaltyText}" />
                <DataGridTextColumn Header="有向转折惩罚"
                                    Width="108"
                                    Binding="{Binding SignedTurnPenaltyText}" />
                <DataGridTextColumn Header="绝对转折惩罚"
                                    Width="108"
                                    Binding="{Binding AbsoluteTurnPenaltyText}" />
                <DataGridTextColumn Header="有向转折差"
                                    Width="108"
                                    Binding="{Binding SignedTurnDeltaText}" />
                <DataGridTextColumn Header="绝对转折差"
                                    Width="108"
                                    Binding="{Binding AbsoluteTurnDeltaText}" />
                <DataGridTextColumn Header="Tap信息"
                                    Width="160"
                                    Binding="{Binding TapInfoText}" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</controls:MetroWindow>
