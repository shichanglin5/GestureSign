<common:TouchWindow x:Name="AppDialog"
                    x:Class="GestureSign.ControlPanel.Dialogs.ApplicationDialog"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls"
                    xmlns:localization="clr-namespace:GestureSign.Common.Localization;assembly=GestureSign.Common"
                    xmlns:common="clr-namespace:GestureSign.ControlPanel.Common"
                    xmlns:converters="clr-namespace:GestureSign.ControlPanel.Converters"
                    xmlns:usercontrols="clr-namespace:GestureSign.ControlPanel.UserControls"
                    xmlns:ui="clr-namespace:GestureSign.Common.UI;assembly=GestureSign.Common"
                    mc:Ignorable="d"
                    Icon="pack://application:,,,/GestureSignControlPanel;component/Resources/normal.ico"
                    SizeToContent="Height"
                    Width="600"
                    ShowIconOnTitleBar="False"
                    WindowStyle="ToolWindow"
                    WindowStartupLocation="CenterScreen"
                    FlowDirection="{StaticResource DefaultFlowDirection}"
                    BorderBrush="{StaticResource MahApps.Brushes.Accent}"
                    Loaded="ApplicationDialog_OnLoaded"
                    ResizeMode="CanMinimize"
                    MaxHeight="400"
                    AllowDrop="True">
    <controls:MetroWindow.Resources>
        <converters:MatchStringConverter x:Key="MatchStringConverter" />
    </controls:MetroWindow.Resources>
    <controls:MetroWindow.Flyouts>
        <controls:FlyoutsControl>
            <controls:Flyout x:Name="MessageFlyout"
                             Theme="Accent"
                             Position="Bottom"
                             CloseButtonVisibility="Collapsed"
                             IsPinned="False"
                             Height="75">
                <TextBlock x:Name="MessageFlyoutText"
                           FontSize="16"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
            </controls:Flyout>
        </controls:FlyoutsControl>
    </controls:MetroWindow.Flyouts>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="35" />
        </Grid.RowDefinitions>
        <StackPanel VerticalAlignment="Top"
                    Margin="0,0,0,20">
            <TextBlock HorizontalAlignment="Left"
                       TextWrapping="Wrap"
                       Text="{localization:LocalisedText ApplicationDialog.GetMatchString}"
                       VerticalAlignment="Top"
                       FontSize="14"
                       FontWeight="Bold"
                       Margin="10,5,0,0" />
            <ui:Crosshair x:Name="chCrosshair"
                                    HorizontalAlignment="Right"
                                    Height="36"
                                    Width="36"
                                    CrosshairDragged="chCrosshair_CrosshairDragged"
                                    CrosshairDragging="ChCrosshair_OnCrosshairDragging"
                                    Margin="0,0,20,0" />
            <TextBlock TextWrapping="Wrap"
                       Text="{localization:LocalisedText ApplicationDialog.DragCrosshair}"
                       Margin="10,-31,60,0" />
            <TextBlock Text="{localization:LocalisedText ApplicationDialog.Or}"
                       Margin="10,0,0,0" />
            <Button x:Name="ShowRunningButton"
                    Content="{localization:LocalisedText ApplicationDialog.ShowRunningApplications}"
                    HorizontalAlignment="Left"
                    Click="ShowRunningButton_Click"
                    FontSize="14"
                    FontWeight="Bold"
                    Margin="10,5,0,0" />
            <TextBlock Text="{localization:LocalisedText ApplicationDialog.Or}"
                       Margin="10,5,0,0" />
            <Button x:Name="BrowseButton"
                    Content="{localization:LocalisedText ApplicationDialog.Browse}"
                    Click="BrowseButton_Click"
                    FontSize="14"
                    FontWeight="Bold"
                    HorizontalAlignment="Left"
                    Margin="10,5,0,0" />
            <TextBlock x:Name="GroupNameTextBlock"
                       HorizontalAlignment="Left"
                       Text="{localization:LocalisedText ApplicationDialog.Group}"
                       FontSize="14"
                       FontWeight="Bold"
                       Margin="10,5,0,0" />
            <ComboBox x:Name="GroupComboBox"
                      IsEditable="True"
                      FontSize="14"
                      Margin="10,5,10,0"
                      controls:TextBoxHelper.Watermark="{localization:LocalisedText Action.DefaultGroup}" />
            <TextBlock x:Name="ApplicationNameTextBlock"
                       HorizontalAlignment="Left"
                       Text="{localization:LocalisedText ApplicationDialog.AppName}"
                       FontSize="14"
                       FontWeight="Bold"
                       Margin="10,5,0,0" />
            <TextBox x:Name="ApplicationNameTextBox"
                     controls:TextBoxHelper.Watermark="{localization:LocalisedText ApplicationDialog.AppNameWatermark}"
                     FontSize="14"
                     Text="{Binding ElementName=AppDialog,Path=ApplicationListViewItem.WindowTitle,Mode=TwoWay}"
                     Margin="10,5,10,0" />
        </StackPanel>
        <ScrollViewer Grid.Row="0"
                      Grid.Column="1"
                      VerticalScrollBarVisibility="Auto"
                      Margin="0,0,0,20">
            <StackPanel>
                <!-- 窗口规则列表 -->
                <StackPanel x:Name="MatchRulesPanel" Margin="10,5,10,0">
                    <TextBlock Text="{localization:LocalisedText ApplicationDialog.WindowRules}"
                               FontSize="14"
                               FontWeight="Bold" />
                    <ListBox x:Name="MatchRulesListBox"
                             MinHeight="26"
                             MaxHeight="80"
                             SelectionMode="Single"
                             BorderThickness="1"
                             BorderBrush="{DynamicResource MahApps.Brushes.Gray7}"
                             SelectionChanged="MatchRulesListBox_SelectionChanged"
                             MouseDoubleClick="MatchRulesListBox_MouseDoubleClick"
                             Margin="0,5,0,0">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{localization:LocalisedText Action.Edit}"
                                          Click="EditMatchRule_Click" />
                                <MenuItem Header="{localization:LocalisedText Common.Delete}"
                                          Click="RemoveMatchRule_Click" />
                                <Separator />
                                <MenuItem Header="{localization:LocalisedText WindowPresets.SaveToPreset}"
                                          Click="SaveMatchRuleToPreset_Click" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" Margin="5,2" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <Button Content="{localization:LocalisedText Common.Add}"
                                Click="AddMatchRule_Click"
                                VerticalAlignment="Center" />
                        <Button x:Name="EditMatchRuleButton"
                                Content="{localization:LocalisedText Action.Edit}"
                                Click="EditMatchRule_Click"
                                Margin="5,0,0,0"
                                VerticalAlignment="Center"
                                IsEnabled="False" />
                        <Button x:Name="DeleteMatchRuleButton"
                                Content="{localization:LocalisedText Common.Delete}"
                                Click="RemoveMatchRule_Click"
                                Margin="5,0,0,0"
                                VerticalAlignment="Center"
                                IsEnabled="False" />
                        <Button Content="{localization:LocalisedText WindowPresets.ReferencePreset}"
                                Click="ReferenceMatchRulePreset_Click"
                                Margin="5,0,0,0"
                                VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
                <TextBlock x:Name="BlockTouchInputTextBlock"
                           Text="{localization:LocalisedText ApplicationDialog.BlockTouchInput}"
                           Margin="10,10,0,0"
                           HorizontalAlignment="Left"
                           FontWeight="Bold"
                           FontSize="14" />
                <TextBlock x:Name="BlockTouchInputInfoTextBlock"
                           Margin="10,5,0,0"
                           HorizontalAlignment="Left" />
                <Slider x:Name="BlockTouchInputSlider"
                        common:SliderTools.MoveToPointOnDrag="True"
                        Margin="30,10,30,0"
                        Maximum="10"
                        SmallChange="1"
                        ValueChanged="BlockTouchInputSlider_ValueChanged"
                        Minimum="1"
                        IsSnapToTickEnabled="True"
                        IsMoveToPointEnabled="True" />
                <TextBlock x:Name="LimitNumberOfFingersTextBlock"
                           Text="{localization:LocalisedText ApplicationDialog.LimitNumberOfFingers}"
                           Margin="10,10,0,0"
                           HorizontalAlignment="Left"
                           FontSize="14"
                           FontWeight="Bold" />
                <TextBlock x:Name="LimitNumberOfFingersInfoTextBlock"
                           Margin="10,5,0,0"
                           HorizontalAlignment="Left" />
                <Slider x:Name="LimitNumberOfFingersSlider"
                        common:SliderTools.MoveToPointOnDrag="True"
                        Margin="30,10,30,0"
                        Maximum="10"
                        SmallChange="1"
                        ValueChanged="LimitNumberOfFingersSlider_ValueChanged"
                        Minimum="1"
                        IsSnapToTickEnabled="True"
                        IsMoveToPointEnabled="True"
                        Value="2" />
                <!-- 鼠标位置检测模式 -->
                <TextBlock x:Name="MouseWindowDetectionTextBlock"
                           Text="{localization:LocalisedText ApplicationDialog.MouseWindowDetection}"
                           FontSize="14"
                           FontWeight="Bold"
                           Margin="10,15,0,0" />
                <ComboBox x:Name="MouseWindowDetectionComboBox"
                          FontSize="14"
                          Margin="10,5,10,0"
                          Width="200"
                          HorizontalAlignment="Left" />
                <!-- 优先级窗口设置 -->
                <StackPanel x:Name="PriorityWindowsPanel"
                            Margin="10,10,10,0">
                    <TextBlock Text="{localization:LocalisedText ApplicationDialog.PriorityWindows}"
                               FontSize="14"
                               FontWeight="Bold" />
                    <TextBlock Text="{localization:LocalisedText ApplicationDialog.PriorityWindowsDescription}"
                               FontSize="11"
                               Foreground="Gray"
                               TextWrapping="Wrap"
                               Margin="0,5,0,10" />
                    <!-- 规则列表 -->
                    <ListBox x:Name="PriorityWindowsListBox"
                             MinHeight="26"
                             MaxHeight="100"
                             SelectionMode="Single"
                             BorderThickness="1"
                             BorderBrush="{DynamicResource MahApps.Brushes.Gray7}"
                             SelectionChanged="PriorityWindowsListBox_SelectionChanged"
                             MouseDoubleClick="PriorityWindowsListBox_MouseDoubleClick">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{localization:LocalisedText Action.Edit}"
                                          Click="EditPriorityWindow_Click" />
                                <MenuItem Header="{localization:LocalisedText Common.Delete}"
                                          Click="RemovePriorityWindow_Click" />
                                <Separator />
                                <MenuItem Header="{localization:LocalisedText WindowPresets.SaveToPreset}"
                                          Click="SavePriorityWindowToPreset_Click" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" Margin="5,2" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <!-- 操作按钮 -->
                    <StackPanel Orientation="Horizontal"
                                Margin="0,5,0,0">
                        <Button Content="{localization:LocalisedText Common.Add}"
                                Click="AddPriorityWindow_Click"
                                VerticalAlignment="Center" />
                        <Button x:Name="EditPriorityWindowButton"
                                Content="{localization:LocalisedText Action.Edit}"
                                Click="EditPriorityWindow_Click"
                                Margin="5,0,0,0"
                                VerticalAlignment="Center"
                                IsEnabled="False" />
                        <Button x:Name="DeletePriorityWindowButton"
                                Content="{localization:LocalisedText Common.Delete}"
                                Click="RemovePriorityWindow_Click"
                                Margin="5,0,0,0"
                                VerticalAlignment="Center"
                                IsEnabled="False" />
                        <Button Content="{localization:LocalisedText WindowPresets.ReferencePreset}"
                                Click="ReferencePriorityWindowPreset_Click"
                                Margin="5,0,0,0"
                                VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <Button x:Name="CancelButton"
                Content="{localization:LocalisedText Common.Cancel}"
                Click="CancelButton_Click"
                FontSize="14"
                Grid.Row="1"
                Grid.Column="0" />
        <Button x:Name="DoneButton"
                Content="{localization:LocalisedText Common.Save}"
                Click="DoneButton_Click"
                IsDefault="True"
                FontSize="14"
                Grid.Row="1"
                Grid.Column="1" />
    </Grid>
</common:TouchWindow>