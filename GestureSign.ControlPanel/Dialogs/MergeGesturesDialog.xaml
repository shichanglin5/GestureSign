<controls:MetroWindow x:Class="GestureSign.ControlPanel.Dialogs.MergeGesturesDialog"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls"
                      Title="合并手势"
                      Width="760"
                      Height="520"
                      MinWidth="680"
                      MinHeight="460"
                      BorderBrush="{StaticResource MahApps.Brushes.Accent}"
                      BorderThickness="1"
                      FlowDirection="{StaticResource DefaultFlowDirection}"
                      ShowIconOnTitleBar="False"
                      WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="选择要保留的目标手势"
                       FontSize="20"
                       FontWeight="SemiBold" />
            <TextBlock Margin="0,8,0,0"
                       Text="已选中的手势会合并到下面选定的目标手势。其他手势的动作绑定将改绑到目标手势，并删除被合并的手势定义。"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource MahApps.Brushes.Accent}" />
        </StackPanel>

        <ListBox Grid.Row="2"
                 x:Name="GestureListBox"
                 ItemsSource="{Binding Options}"
                 BorderThickness="1"
                 BorderBrush="{DynamicResource MahApps.Brushes.Gray4}"
                 SelectedItem="{Binding SelectedOption, Mode=TwoWay}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="10,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Padding="4"
                                    CornerRadius="6"
                                    Background="{DynamicResource MahApps.Brushes.Accent4}">
                                <Image Height="54"
                                       Stretch="Uniform"
                                       Source="{Binding GestureImage}" />
                            </Border>
                            <StackPanel Grid.Column="2"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}"
                                           FontSize="16"
                                           FontWeight="SemiBold" />
                                <TextBlock Margin="0,6,0,0"
                                           Text="{Binding FingerCountText}"
                                           Foreground="{DynamicResource MahApps.Brushes.Accent}" />
                                <TextBlock Margin="0,4,0,0"
                                           Text="{Binding ApplicationsSummary}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource MahApps.Brushes.Gray1}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <DockPanel Grid.Row="4"
                   LastChildFill="False">
            <TextBlock Text="{Binding MergeSummaryText}"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource MahApps.Brushes.Accent}" />
            <Button Content="取消"
                    Width="96"
                    Height="34"
                    Margin="12,0,0,0"
                    Click="CancelButton_Click"
                    DockPanel.Dock="Right" />
            <Button Content="合并到该手势"
                    Width="132"
                    Height="34"
                    Margin="12,0,0,0"
                    IsEnabled="{Binding CanMerge}"
                    Click="MergeButton_Click"
                    DockPanel.Dock="Right" />
        </DockPanel>
    </Grid>
</controls:MetroWindow>
