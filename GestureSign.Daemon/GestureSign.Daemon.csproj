<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>GestureSign.Daemon</RootNamespace>
    <AssemblyName>GestureSign</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Resources\normal.ico</ApplicationIcon>
    <Deterministic>false</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <!-- Debug: Show console window for easy control -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <!-- Release/Other: No console window (background service) -->
  <PropertyGroup Condition="'$(Configuration)' != 'Debug'">
    <OutputType>WinExe</OutputType>
  </PropertyGroup>

  <!-- Application Manifest Selection -->
  <PropertyGroup Condition="'$(Configuration)' != 'uiAccessRelease'">
    <ApplicationManifest>Properties\app.manifest</ApplicationManifest>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'uiAccessRelease'">
    <ApplicationManifest>Properties\app.uiAccessRelease.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- Build Configurations -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <OutputPath>..\bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <OutputPath>..\bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Portable'">
    <OutputPath>..\bin\Portable\</OutputPath>
    <DefineConstants>TRACE;Portable</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Centennial'">
    <OutputPath>..\bin\Centennial\</OutputPath>
    <DefineConstants>TRACE;ConvertedDesktopApp</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'uiAccessRelease'">
    <OutputPath>..\bin\uiAccessRelease\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GestureSign.Common\GestureSign.Common.csproj" />
    <ProjectReference Include="..\GestureSign.PointPatterns\GestureSign.PointPatterns.csproj" />
    <ProjectReference Include="..\GestureSign.CorePlugins\GestureSign.CorePlugins.csproj" />
    <ProjectReference Include="..\ManagedWinapi\ManagedWinapi.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\*.ico" />
    <Resource Include="Resources\*.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Languages\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- PreBuild: Stop running GestureSign processes before building -->
  <Target Name="StopGestureSignProcesses" BeforeTargets="BeforeBuild">
    <Message Text="Stopping running GestureSign processes..." Importance="high" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;Get-Process -Name 'GestureSign*' -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue&quot;"
          IgnoreExitCode="true"
          ContinueOnError="true" />
  </Target>

  <!-- PostBuild for uiAccessRelease: Sign the executable -->
  <Target Name="SignExecutable" AfterTargets="AfterBuild" Condition="'$(Configuration)' == 'uiAccessRelease'">
    <Message Text="Signing UIAccess executable..." Importance="high" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(ProjectDir)..\scripts\Sign-Code.ps1&quot; -BuildConfiguration $(Configuration)"
          WorkingDirectory="$(ProjectDir)..\scripts"
          IgnoreExitCode="false" />
  </Target>

</Project>
