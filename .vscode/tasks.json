    // ==================== 复合工作流任务 ====================
    {
      "label": "workflow: debug-full",
      "dependsOn": [
        "stop-gesturesign",
        "debug: build",
        "run: daemon-debug",
        "run: controlpanel-debug"
      ],
      "dependsOrder": "sequence",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": false
      },
      "problemMatcher": []
    },

    {
      "label": "workflow: release-full",
      "dependsOn": [
        "stop-gesturesign",
        "release: build",
        "run: daemon-release"
      ],
      "dependsOrder": "sequence",
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": false
      },
      "problemMatcher": []
    },

    {
      "label": "workflow: uiaccess-full",
      "dependsOn": [
        "stop-gesturesign",
        "uiAccessRelease: rebuild",
        "signing: sign-uiaccess",
        "uiaccess: copy-to-programfiles",
        "uiaccess: check-status"
      ],
      "dependsOrder": "sequence",
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": false
      },
      "problemMatcher": []
