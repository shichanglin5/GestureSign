        "showReuseMessage": false,
        "clear": false
      },
      "problemMatcher": []
    },

    {
      "label": "run: controlpanel-release",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-Command",
        "Start-Process -FilePath 'D:\\wd\\soft\\GestureSign\\GestureSignControlPanel.exe' -WorkingDirectory 'D:\\wd\\soft\\GestureSign'"
      ],
      "group": "none",
      "presentation": {
        "echo": true,
        "reveal": "silent",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": false
