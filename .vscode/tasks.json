{
  "version": "2.0.0",
  "tasks": [
    // ==================== 进程管理 ====================
    {
      "label": "stop: gesturesign",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-Command",
        "Get-Process -Name 'GestureSign*' -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue; Write-Host 'GestureSign processes stopped' -ForegroundColor Green"
      ],
      "presentation": {
        "echo": true,
        "reveal": "silent",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": false
      },
      "problemMatcher": []
    },

    // ==================== 构建任务 (Debug) ====================
    {
      "label": "debug: build",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/GestureSign.sln",
        "-c",
        "Debug",
        "-v",
        "minimal"
      ],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "problemMatcher": "$msCompile"
    },

        // ==================== 强制重新构建 ====================
    {
      "label": "debug: rebuild",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/GestureSign.sln",
        "-c",
        "Debug",
        "--no-incremental",
        "-v",
        "minimal"
      ],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "problemMatcher": "$msCompile"
    },

    // ==================== 清理任务 ====================
