      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "log: delete",
      "detail": "Remove-Item $env:LOCALAPPDATA\\GestureSign\\GestureSign.log",
      "type": "shell",
      "command": "powershell",
      "args": [
