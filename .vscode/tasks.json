{
  "version": "2.0.0",
  // ============================================================
  // GestureSign 开发任务配置
  // ============================================================
  //
  // 常用工作流任务:
  //   - workflow: debug-full (Ctrl+Shift+B) - 完整 Debug 工作流
  //   - workflow: release-full - 完整 Release 工作流
  //   - workflow: uiaccess-full - 完整 UIAccess 工作流 (需要管理员)
  //
  // 原子任务分类:
  //   - stop-gesturesign - 停止所有进程
  //   - debug/release/uiAccess: build/clean/restart
  //   - signing: sign/verify
  //   - copy: to-programfiles
  //   - run: daemon-*/controlpanel-*
  //   - system: *-testmode
  //   - log: tail/delete
  //
  // ============================================================
  "tasks": [
    // ==================== 进程管理 ====================
    {
      "label": "stop-gesturesign",
      "type": "shell",
      "command": "powershell",
      "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/Stop-GestureSign.ps1"],
      "presentation": { "echo": true, "reveal": "silent", "panel": "shared", "showReuseMessage": false },
      "problemMatcher": []
    },
    // ==================== 基础构建任务 ====================
    {
      "label": "debug: build",
      "type": "shell",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/GestureSign.sln", "-c", "Debug", "-v", "minimal"],
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "debug: clean",
      "type": "shell",
      "command": "dotnet",
      "args": ["clean", "${workspaceFolder}/GestureSign.sln", "-c", "Debug", "-v", "minimal"],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "debug: restart",
      "dependsOn": ["stop-gesturesign", "log: delete", "run: daemon-debug", "log: tail"],
      "dependsOrder": "sequence",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "release: build",
      "type": "shell",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/GestureSign.sln", "-c", "Release", "-v", "minimal"],
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "release: clean",
      "type": "shell",
      "command": "dotnet",
      "args": ["clean", "${workspaceFolder}/GestureSign.sln", "-c", "Release", "-v", "minimal"],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "release: restart",
      "dependsOn": ["stop-gesturesign", "log: delete", "run: daemon-release", "log: tail"],
      "dependsOrder": "sequence",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "uiAccess: build",
      "type": "shell",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/GestureSign.sln", "-c", "uiAccessRelease", "-v", "minimal"],
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "uiAccess: clean",
      "type": "shell",
      "command": "dotnet",
      "args": ["clean", "${workspaceFolder}/GestureSign.sln", "-c", "uiAccessRelease", "-v", "minimal"],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "uiAccess: restart",
      "dependsOn": ["stop-gesturesign", "log: delete", "run: daemon-uiaccess", "log: tail"],
      "dependsOrder": "sequence",
      "group": "build",
      "problemMatcher": []
    },
    // ==================== Windows 系统任务 ====================
    {
      "label": "system: check-testmode",
      "type": "shell",
      "command": "powershell",
      "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/Manage-TestMode.ps1", "-Action", "check"],
      "group": "test",
      "presentation": { "echo": true, "reveal": "always", "focus": true, "panel": "dedicated", "showReuseMessage": false },
      "problemMatcher": []
    },
    {
      "label": "system: enable-testmode",
      "type": "shell",
      "command": "powershell",
      "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/Manage-TestMode.ps1", "-Action", "enable"],
      "presentation": { "echo": true, "reveal": "always", "focus": true, "panel": "dedicated", "showReuseMessage": false },
      "problemMatcher": []
    },
    {
      "label": "system: disable-testmode",
      "type": "shell",
      "command": "powershell",
      "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/Manage-TestMode.ps1", "-Action", "disable"],
      "presentation": { "echo": true, "reveal": "always", "focus": true, "panel": "dedicated", "showReuseMessage": false },
      "problemMatcher": []
    },
    // ==================== 日志任务 ====================
    {
      "label": "log: tail",
      "detail": "实时跟踪 GestureSign 日志",
      "type": "shell",
      "command": "powershell",
      "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/Manage-Log.ps1", "-Action", "tail"],
      "presentation": { "echo": false, "reveal": "always", "focus": true, "panel": "dedicated", "showReuseMessage": false, "clear": true },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "log: delete",
      "detail": "删除 GestureSign 日志文件",
      "type": "shell",
      "command": "powershell",
      "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/Manage-Log.ps1", "-Action", "delete"],
      "presentation": { "echo": false, "reveal": "silent", "panel": "shared", "showReuseMessage": false },
      "problemMatcher": []
    },
    // ==================== 运行任务 ====================
    {
      "label": "run: daemon-debug",
      "type": "shell",
      "command": "powershell",
      "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/Run-GestureSign.ps1", "-Config", "debug"],
      "presentation": { "echo": true, "reveal": "silent", "panel": "shared", "showReuseMessage": false },
      "problemMatcher": []
    },
    {
      "label": "run: controlpanel-debug",
      "type": "shell",
      "command": "powershell",
      "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/Run-GestureSign.ps1", "-Config", "debug", "-ControlPanel"],
      "presentation": { "echo": true, "reveal": "silent", "panel": "shared", "showReuseMessage": false },
      "problemMatcher": []
    },
    {
      "label": "run: daemon-release",
      "type": "shell",
      "command": "powershell",
      "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/Run-GestureSign.ps1", "-Config", "release"],
      "presentation": { "echo": true, "reveal": "silent", "panel": "shared", "showReuseMessage": false },
      "problemMatcher": []
    },
    {
      "label": "run: controlpanel-release",
      "type": "shell",
      "command": "powershell",
      "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/Run-GestureSign.ps1", "-Config", "release", "-ControlPanel"],
      "presentation": { "echo": true, "reveal": "silent", "panel": "shared", "showReuseMessage": false },
      "problemMatcher": []
    },
    {
      "label": "run: daemon-uiaccess",
      "type": "shell",
      "command": "powershell",
      "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/Run-GestureSign.ps1", "-Config", "uiaccess"],
      "presentation": { "echo": true, "reveal": "always", "panel": "dedicated", "showReuseMessage": false },
      "problemMatcher": []
    },
    {
      "label": "run: controlpanel-uiaccess",
      "type": "shell",
      "command": "powershell",
      "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/Run-GestureSign.ps1", "-Config", "uiaccess", "-ControlPanel"],
      "presentation": { "echo": true, "reveal": "silent", "panel": "shared", "showReuseMessage": false },
      "problemMatcher": []
    },
    // ==================== 签名与部署 ====================
    {
      "label": "signing: sign",
      "detail": "对 uiAccessRelease 构建输出进行代码签名",
      "type": "shell",
      "command": "powershell",
      "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/Sign-Code.ps1"],
      "presentation": { "echo": true, "reveal": "always", "panel": "dedicated", "showReuseMessage": false },
      "problemMatcher": []
    },
    {
      "label": "signing: verify",
      "detail": "验证 Program Files 中的数字签名",
      "type": "shell",
      "command": "powershell",
      "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/Verify-Signature.ps1"],
      "presentation": { "echo": true, "reveal": "always", "panel": "dedicated", "showReuseMessage": false },
      "problemMatcher": []
    },
    {
      "label": "copy: to-programfiles",
      "detail": "复制构建输出到 Program Files",
      "type": "shell",
      "command": "powershell",
      "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/Copy-ToProgramFiles.ps1"],
      "presentation": { "echo": true, "reveal": "always", "panel": "dedicated", "showReuseMessage": false },
      "problemMatcher": []
    },
    // ==================== 复合工作流任务 ====================
    {
      "label": "build-and-stop-debug",
      "dependsOn": ["stop-gesturesign", "debug: build"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "workflow: debug",
      "dependsOn": ["stop-gesturesign", "log: delete", "debug: build", "run: daemon-debug", "log: tail"],
      "dependsOrder": "sequence",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "workflow: release",
      "dependsOn": ["stop-gesturesign", "log: delete", "release: clean", "release: build", "run: daemon-release", "log: tail"],
      "dependsOrder": "sequence",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "workflow: uiaccess",
      "dependsOn": ["stop-gesturesign", "log: delete", "uiAccess: build", "signing: sign", "copy: to-programfiles", "run: daemon-uiaccess", "log: tail"],
      "dependsOrder": "sequence",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "workflow: uiaccess-full",
      "dependsOn": ["stop-gesturesign", "log: delete", "uiAccess: clean", "uiAccess: build", "signing: sign", "copy: to-programfiles", "run: daemon-uiaccess", "log: tail"],
      "dependsOrder": "sequence",
      "group": "build",
      "problemMatcher": []
    }
  ]
}
