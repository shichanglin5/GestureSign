        "-Command",
        "Start-Process -FilePath 'D:\\wd\\soft\\GestureSign\\GestureSign.exe' -WorkingDirectory 'D:\\wd\\soft\\GestureSign'"
      ],
      "group": "none",
      "presentation": {
        "echo": true,
