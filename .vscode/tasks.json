    // ==================== 复合任务 ====================
    {
      "label": "stop-clean-rebuild-debug",
      "dependsOn": [
        "stop: gesturesign",
        "clean-debug",
        "rebuild-debug"
      ],
      "dependsOrder": "sequence",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
