{
  "version": "2.0.0",
  // ============================================================
  // GestureSign 开发任务配置
  // ============================================================
  //
  // 常用任务:
  //   - workflow: debug-full (Ctrl+Shift+B) - 完整 Debug 工作流
  //   - workflow: release-full - 完整 Release 工作流
  //   - stop-gesturesign - 停止所有 GestureSign 进程
  //
  // UIAccess 开发 (需要管理员权限):
  //   1. signing: setup-certificate - 首次设置证书
  //   2. workflow: uiaccess-full - 完整 UIAccess 工作流
  //   3. uiaccess: enable-testmode - 启用测试模式（需重启）
  //
  // 运行任务:
  //   - run: daemon-debug/release - 仅运行 Daemon
  //   - run: controlpanel-debug/release - 仅运行 Control Panel
  //
  // ============================================================
  "tasks": [
    // ==================== 进程管理 ====================
    // stop-gesturesign - 停止所有 GestureSign 进程

    {
      "label": "stop-gesturesign",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-Command",
        "Get-Process -Name 'GestureSign*' -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue; Write-Host 'GestureSign processes stopped' -ForegroundColor Green"
      ],
      "presentation": {
        "echo": true,
        "reveal": "silent",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": false
      },
      "problemMatcher": []
    },

    // ==================== 基础构建任务 (内部使用) ====================
    {
      "label": "debug: build",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/GestureSign.sln",
        "-c",
        "Debug",
        "-v",
        "minimal"
      ],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "debug: clean",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "clean",
        "${workspaceFolder}/GestureSign.sln",
        "-c",
        "Debug",
        "-v",
        "minimal"
      ],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "problemMatcher": []
    },
    {
      "label": "release: build",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/GestureSign.sln",
        "-c",
        "Release",
        "-v",
        "minimal"
      ],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "problemMatcher": "$msCompile"
    },

    {
      "label": "release: rebuild",
      "dependsOn": [
        "release: clean",
        "release: build"
      ],
      "dependsOrder": "sequence",
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "problemMatcher": []
    },

    {
      "label": "release: clean",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "clean",
        "${workspaceFolder}/GestureSign.sln",
        "-c",
        "Release",
        "-v",
        "minimal"
      ],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "problemMatcher": []
    },

    {
      "label": "release: stop-build-run",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/Build-And-Run.ps1",
        "-Configuration",
        "Release"
      ],
      "group": "run",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": false
      },
      "problemMatcher": []
    },

    // ==================== 构建任务 (uiAccessRelease) ====================
    {
      "label": "uiAccessRelease: build",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/GestureSign.sln",
        "-c",
        "uiAccessRelease",
        "-v",
        "minimal"
      ],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "problemMatcher": "$msCompile"
    },

    {
      "label": "uiAccessRelease: rebuild",
      "dependsOn": [
        "uiAccessRelease: clean",
        "uiAccessRelease: build"
      ],
      "dependsOrder": "sequence",
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "problemMatcher": []
    },

    {
      "label": "uiAccessRelease: clean",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "clean",
        "${workspaceFolder}/GestureSign.sln",
        "-c",
        "uiAccessRelease",
        "-v",
        "minimal"
      ],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "problemMatcher": []
    },

    {
      "label": "clean-all-configs",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-Command",
        "Write-Host 'Cleaning all build outputs...' -ForegroundColor Yellow; Remove-Item -Recurse -Force bin,obj -ErrorAction SilentlyContinue; Write-Host 'All bin and obj directories deleted' -ForegroundColor Green"
      ],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": false
      },
      "problemMatcher": []
    },

    // ==================== UIAccess 专用任务 ====================
    {
      "label": "build-and-run-uiAccessRelease",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/Build-And-Run.ps1",
        "-Configuration",
        "uiAccessRelease"
      ],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": false
      },
      "problemMatcher": []
    },

    {
      "label": "sign-code-uiAccessRelease",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/Sign-Code.ps1",
        "-BuildConfiguration",
        "uiAccessRelease"
      ],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": false
      },
      "problemMatcher": []
    },

    {
      "label": "build-and-stop-debug",
      "dependsOn": [
        "stop-gesturesign",
        "debug: build"
      ],
      "dependsOrder": "sequence",
      "presentation": {
        "echo": true,
        "reveal": "silent",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": false
      },
      "problemMatcher": "$msCompile"
    },

        {
      "label": "build-and-stop-debug-daemon",
      "dependsOn": [
        "stop gesturesign",
        "debug: build daemon"
      ],
      "dependsOrder": "sequence",
      "presentation": {
        "echo": true,
        "reveal": "silent",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": false
      },
      "problemMatcher": "$msCompile"
    },

    // ==================== 代码签名任务 ====================
    {
      "label": "signing: setup-certificate",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/Sign-Code.ps1",
        "-SkipSigning"
      ],
      "group": "none",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": false
      },
      "problemMatcher": []
    },

    {
      "label": "signing: sign-uiaccess",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/Sign-Code.ps1",
        "-BuildConfiguration",
        "uiAccessRelease"
      ],
      "group": "none",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": false
      },
      "problemMatcher": []
    },

    // ==================== UIAccess 测试与部署任务 ====================
    {
