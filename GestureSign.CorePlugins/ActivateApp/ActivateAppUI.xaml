<UserControl x:Class="GestureSign.CorePlugins.ActivateApp.ActivateAppUI"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:localization="clr-namespace:GestureSign.Common.Localization;assembly=GestureSign.Common"
             mc:Ignorable="d"
             d:DesignHeight="350"
             d:DesignWidth="450">
    <StackPanel Margin="10">
        <!-- Configuration Method Label -->
        <TextBlock Text="{localization:LocalisedText CorePlugins.ActivateApp.ConfigMethod}"
                   FontWeight="Bold"
                   FontSize="14"
                   Margin="0,5,0,0" />

        <!-- Select from Running Windows Button -->
        <Button x:Name="SelectWindowButton"
                Content="{localization:LocalisedText CorePlugins.ActivateApp.SelectWindow}"
                Click="SelectWindowButton_Click"
                FontSize="14"
                FontWeight="Bold"
                HorizontalAlignment="Left"
                Margin="0,5,0,0" />

        <TextBlock Text="{localization:LocalisedText CorePlugins.ActivateApp.Or}"
                   Margin="0,5,0,0" />

        <!-- Browse for Application Button -->
        <Button x:Name="BrowseButton"
                Content="{localization:LocalisedText CorePlugins.ActivateApp.Browse}"
                Click="BrowseButton_Click"
                FontSize="14"
                FontWeight="Bold"
                HorizontalAlignment="Left"
                Margin="0,5,0,10" />

        <!-- Application Path Display -->
        <TextBlock Text="{localization:LocalisedText CorePlugins.ActivateApp.AppPath}"
                   Margin="0,10,0,5" />

        <TextBox x:Name="AppPathTextBox"
                 Height="23"
                 IsReadOnly="True"
                 VerticalAlignment="Top" />

        <!-- Advanced Filters -->
        <Expander Header="{localization:LocalisedText CorePlugins.ActivateApp.AdvancedFilters}"
                  IsExpanded="False"
                  Margin="0,10,0,0">
            <StackPanel Margin="10,10,0,10">
                <TextBlock Text="{localization:LocalisedText CorePlugins.ActivateApp.WindowClassName}"
                           Margin="0,0,0,5" />

                <TextBox x:Name="WindowClassNameTextBox"
                         Height="23"
                         Margin="0,0,0,10" />

                <TextBlock Text="{localization:LocalisedText CorePlugins.ActivateApp.WindowTitlePattern}"
                           Margin="0,0,0,5" />

                <TextBox x:Name="WindowTitlePatternTextBox"
                         Height="23"
                         Margin="0,0,0,10" />

                <CheckBox x:Name="UseRegexCheckBox"
                          Content="{localization:LocalisedText CorePlugins.ActivateApp.UseRegex}"
                          Margin="0,0,0,10" />

                <TextBlock Text="{localization:LocalisedText CorePlugins.ActivateApp.DisplayName}"
                           Margin="0,0,0,5" />

                <TextBox x:Name="DisplayNameTextBox"
                         Height="23" />
            </StackPanel>
        </Expander>
    </StackPanel>
</UserControl>
