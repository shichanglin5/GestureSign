<UserControl x:Class="GestureSign.CorePlugins.ActivateApp.ActivateAppUI"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:localization="clr-namespace:GestureSign.Common.Localization;assembly=GestureSign.Common"
             xmlns:ui="clr-namespace:GestureSign.Common.UI;assembly=GestureSign.Common"
             xmlns:local="clr-namespace:GestureSign.CorePlugins.ActivateApp"
             mc:Ignorable="d"
             Height="400"
             d:DesignHeight="400"
             d:DesignWidth="450"
             Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}">
    <StackPanel Margin="10">
        <!-- Configuration Method Label -->
            <TextBlock Text="{localization:LocalisedText CorePlugins.ActivateApp.ConfigMethod}"
                       FontWeight="Bold"
                       FontSize="14"
                       Margin="0,5,0,0" />

            <!-- Select from Running Windows Button + Crosshair Capture -->
            <StackPanel Orientation="Horizontal" Margin="0,5,0,10">
                <Button x:Name="SelectWindowButton"
                        Content="{localization:LocalisedText CorePlugins.ActivateApp.SelectWindow}"
                        Click="SelectWindowButton_Click"
                        FontSize="14"
                        FontWeight="Bold"
                        HorizontalAlignment="Left" />
                <ui:Crosshair x:Name="CaptureCrosshair"
                              Height="36"
                              Width="36"
                              Margin="10,0,0,0"
                              VerticalAlignment="Center"
                              CrosshairDragged="CaptureCrosshair_CrosshairDragged"
                              ToolTip="{localization:LocalisedText CorePlugins.ActivateApp.DragToCapture}" />
            </StackPanel>

            <!-- Display Name -->
            <TextBlock Text="{localization:LocalisedText CorePlugins.ActivateApp.DisplayName}"
                       Margin="0,10,0,5" />

            <TextBox x:Name="DisplayNameTextBox"
                     Height="23"
                     VerticalAlignment="Top"
                     Margin="0,0,0,10" />

            <!-- Matching Conditions -->
            <TextBlock Text="Matching Conditions / 匹配条件"
                       FontWeight="Bold"
                       Margin="0,10,0,5" />

            <local:MatchConditionListControl x:Name="MatchConditionList"
                                              Margin="0,0,0,10" />

            <!-- Advanced Filters -->
            <Expander Header="{localization:LocalisedText CorePlugins.ActivateApp.AdvancedFilters}"
                      IsExpanded="False"
                      Margin="0,10,0,0">
                <StackPanel Margin="10,10,0,10">
                    <CheckBox x:Name="MinimizeIfActivatedCheckBox"
                              Content="{localization:LocalisedText CorePlugins.ActivateApp.MinimizeIfActivated}"
                              IsChecked="True"
                              Margin="0,0,0,10" />

                    <TextBlock Text="Cache Expiration (seconds) / 窗口列表缓存过期时间（秒）"
                               Margin="0,0,0,5" />

                    <TextBox x:Name="CacheExpirationTextBox"
                             Height="23"
                             Text="30"
                             Margin="0,0,0,5" />

                    <TextBlock Text="Set to 0 to disable caching / 设置为 0 禁用缓存"
                               FontSize="11"
                               Foreground="Gray"
                               Margin="0,0,0,10" />
                </StackPanel>
            </Expander>
    </StackPanel>
</UserControl>
