<UserControl x:Class="GestureSign.CorePlugins.ActivateApp.ActivateAppUI"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:localization="clr-namespace:GestureSign.Common.Localization;assembly=GestureSign.Common"
             mc:Ignorable="d"
             d:DesignHeight="350"
             d:DesignWidth="450">
    <StackPanel Margin="10">
        <!-- Configuration Method Label -->
        <TextBlock Text="{localization:LocalisedText CorePlugins.ActivateApp.ConfigMethod}"
                   FontWeight="Bold"
                   FontSize="14"
                   Margin="0,5,0,0" />

        <!-- Select from Running Windows Button -->
        <Button x:Name="SelectWindowButton"
                Content="{localization:LocalisedText CorePlugins.ActivateApp.SelectWindow}"
                Click="SelectWindowButton_Click"
                FontSize="14"
                FontWeight="Bold"
                HorizontalAlignment="Left"
                Margin="0,5,0,10" />

        <!-- Display Name -->
        <TextBlock Text="{localization:LocalisedText CorePlugins.ActivateApp.DisplayName}"
                   Margin="0,10,0,5" />

        <TextBox x:Name="DisplayNameTextBox"
                 Height="23"
                 VerticalAlignment="Top"
                 Margin="0,0,0,10" />

        <!-- Advanced Filters -->
        <Expander Header="{localization:LocalisedText CorePlugins.ActivateApp.AdvancedFilters}"
                  IsExpanded="False"
                  Margin="0,10,0,0">
            <StackPanel Margin="10,10,0,10">
                <TextBlock Text="{localization:LocalisedText CorePlugins.ActivateApp.WindowTitlePattern}"
                           Margin="0,0,0,5" />

                <TextBox x:Name="WindowTitlePatternTextBox"
                         Height="23"
                         Margin="0,0,0,10" />

                <CheckBox x:Name="UseRegexCheckBox"
                          Content="{localization:LocalisedText CorePlugins.ActivateApp.UseRegex}"
                          Margin="0,0,0,10" />

                <TextBlock Text="Cache Expiration (seconds) / 缓存过期时间（秒）"
                           Margin="0,0,0,5" />

                <TextBox x:Name="CacheExpirationTextBox"
                         Height="23"
                         Margin="0,0,0,5" />

                <TextBlock Text="Set to 0 to disable caching / 设置为 0 禁用缓存"
                           FontSize="11"
                           Foreground="Gray"
                           Margin="0,0,0,10" />
            </StackPanel>
        </Expander>

        <!-- Matching Configuration Display -->
        <TextBlock Text="Current Matching Configuration / 当前匹配配置"
                   FontWeight="Bold"
                   Margin="0,20,0,5" />

        <DataGrid x:Name="ConfigDataGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  Height="150"
                  HeadersVisibility="Column"
                  GridLinesVisibility="None"
                  CanUserResizeRows="False"
                  CanUserSortColumns="False"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Property / 属性"
                                    Binding="{Binding Name}"
                                    Width="150"
                                    FontWeight="Bold" />
                <DataGridTextColumn Header="Value / 值"
                                    Binding="{Binding Value}"
                                    Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap" />
                            <Setter Property="FontFamily" Value="Consolas" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </StackPanel>
</UserControl>
