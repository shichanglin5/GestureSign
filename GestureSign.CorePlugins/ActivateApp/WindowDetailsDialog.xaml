<Window x:Class="GestureSign.CorePlugins.ActivateApp.WindowDetailsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Window Details / 窗口详细信息"
        Height="600" Width="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 详细信息表格 -->
        <DataGrid x:Name="DetailsDataGrid"
                  Grid.Row="0"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserSortColumns="False"
                  CanUserResizeRows="False"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  SelectionMode="Single"
                  AlternatingRowBackground="#F5F5F5">

            <DataGrid.Columns>
                <!-- 属性分类 -->
                <DataGridTextColumn Header="Category / 分类"
                                  Binding="{Binding Category}"
                                  Width="150"
                                  FontWeight="Bold"/>

                <!-- 属性名称 -->
                <DataGridTextColumn Header="Property / 属性"
                                  Binding="{Binding Name}"
                                  Width="200"/>

                <!-- 属性值 -->
                <DataGridTextColumn Header="Value / 值"
                                  Binding="{Binding Value}"
                                  Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="FontFamily" Value="Consolas"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 关闭按钮 -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Content="Copy All / 复制全部"
                    Width="120"
                    Margin="0,0,10,0"
                    Click="CopyButton_Click"/>
            <Button Content="Close / 关闭"
                    Width="75"
                    IsCancel="True"
                    Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
