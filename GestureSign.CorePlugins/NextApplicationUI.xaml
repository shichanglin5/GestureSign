<UserControl x:Class="GestureSign.CorePlugins.NextApplicationUI"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:localization="clr-namespace:GestureSign.Common.Localization;assembly=GestureSign.Common"
             d:DesignHeight="60"
             d:DesignWidth="400"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <StackPanel Margin="10">
        <CheckBox x:Name="SkipMinimizedCheckBox"
                  Content="{localization:LocalisedText CorePlugins.NextApplication.SkipMinimizedWindows}"
                  IsChecked="True"
                  FontSize="14"
                  Margin="0,5,0,0" />
    </StackPanel>
</UserControl>
