<UserControl x:Class="GestureSign.CorePlugins.InertialScroll.InertialScrollUI"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:GestureSign.CorePlugins.InertialScroll"
             xmlns:localization="clr-namespace:GestureSign.Common.Localization;assembly=GestureSign.Common"
             mc:Ignorable="d"
             d:DesignHeight="400"
             d:DesignWidth="320">
    <StackPanel Margin="10">

        <!-- 滚动方向 -->
        <TextBlock Text="{localization:LocalisedText CorePlugins.InertialScroll.ScrollDirection}" FontSize="14" Margin="0,0,0,5"/>
        <ComboBox x:Name="DirectionComboBox" FontSize="14" Margin="0,0,0,15"
                  SelectionChanged="DirectionComboBox_SelectionChanged">
            <ComboBoxItem Content="{localization:LocalisedText CorePlugins.InertialScroll.DirectionVertical}" Tag="Vertical" IsSelected="True"/>
            <ComboBoxItem Content="{localization:LocalisedText CorePlugins.InertialScroll.DirectionHorizontal}" Tag="Horizontal"/>
            <ComboBoxItem Content="{localization:LocalisedText CorePlugins.InertialScroll.DirectionBoth}" Tag="Both"/>
        </ComboBox>

        <!-- 启用惯性 -->
        <CheckBox x:Name="EnableInertiaCheckBox"
                  Content="{localization:LocalisedText CorePlugins.InertialScroll.EnableInertialScrolling}"
                  IsChecked="True"
                  FontSize="14"
                  Margin="0,0,0,10"
                  Checked="EnableInertiaCheckBox_Changed"
                  Unchecked="EnableInertiaCheckBox_Changed"/>

        <StackPanel x:Name="InertiaPanel" IsEnabled="{Binding ElementName=EnableInertiaCheckBox, Path=IsChecked}">

            <!-- 惯性强度 -->
            <TextBlock Text="{localization:LocalisedText CorePlugins.InertialScroll.InertiaStrength}" FontSize="14" Margin="0,0,0,5"/>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <Slider x:Name="InertiaStrengthSlider"
                        Minimum="0.5" Maximum="2.0" Value="1.0"
                        TickFrequency="0.1" IsSnapToTickEnabled="True"
                        ValueChanged="Slider_ValueChanged"/>
                <TextBox Grid.Column="1"
                         Text="{Binding ElementName=InertiaStrengthSlider, Path=Value, StringFormat=F1}"
                         IsReadOnly="True" TextAlignment="Center" Margin="5,0,0,0"/>
            </Grid>

            <!-- 持续时间 -->
            <TextBlock Text="{localization:LocalisedText CorePlugins.InertialScroll.InertiaDuration}" FontSize="14" Margin="0,0,0,5"/>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <Slider x:Name="DurationSlider"
                        Minimum="0.5" Maximum="3.0" Value="1.5"
                        TickFrequency="0.1" IsSnapToTickEnabled="True"
                        ValueChanged="Slider_ValueChanged"/>
                <TextBox Grid.Column="1"
                         Text="{Binding ElementName=DurationSlider, Path=Value, StringFormat=F1}"
                         IsReadOnly="True" TextAlignment="Center" Margin="5,0,0,0"/>
            </Grid>

            <!-- 高级设置 -->
            <Expander Header="{localization:LocalisedText CorePlugins.InertialScroll.AdvancedSettings}" IsExpanded="False" Margin="0,10,0,0">
                <StackPanel Margin="0,10,0,0">
                    <TextBlock Text="{localization:LocalisedText CorePlugins.InertialScroll.DecayRate}" FontSize="14" Margin="0,0,0,5"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="DecayRateSlider"
                                Minimum="0.85" Maximum="0.98" Value="0.95"
                                TickFrequency="0.01" IsSnapToTickEnabled="True"
                                ValueChanged="Slider_ValueChanged"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding ElementName=DecayRateSlider, Path=Value, StringFormat=F2}"
                                 IsReadOnly="True" TextAlignment="Center" Margin="5,0,0,0"/>
                    </Grid>

                    <TextBlock Text="{localization:LocalisedText CorePlugins.InertialScroll.MinimumVelocity}" FontSize="14" Margin="0,0,0,5"/>
                    <TextBox x:Name="MinVelocityTextBox" Text="50" FontSize="14" Margin="0,0,0,10"
                             TextChanged="MinVelocityTextBox_TextChanged"/>

                    <TextBlock Text="{localization:LocalisedText CorePlugins.InertialScroll.PixelsPerScrollUnit}" FontSize="14" Margin="0,0,0,5"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="PixelsPerScrollUnitSlider"
                                Minimum="3.0" Maximum="30.0" Value="5.0"
                                TickFrequency="1.0" IsSnapToTickEnabled="True"
                                ValueChanged="Slider_ValueChanged"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding ElementName=PixelsPerScrollUnitSlider, Path=Value, StringFormat=F1}"
                                 IsReadOnly="True" TextAlignment="Center" Margin="5,0,0,0"/>
                    </Grid>
                </StackPanel>
            </Expander>

        </StackPanel>

        <!-- 距离倍数 -->
        <TextBlock Text="{localization:LocalisedText CorePlugins.InertialScroll.DistanceMultiplier}" FontSize="14" Margin="0,10,0,5"/>
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="60"/>
            </Grid.ColumnDefinitions>
            <Slider x:Name="MultiplierSlider"
                    Minimum="0.5" Maximum="3.0" Value="1.0"
                    TickFrequency="0.1" IsSnapToTickEnabled="True"
                    ValueChanged="Slider_ValueChanged"/>
            <TextBox Grid.Column="1"
                     Text="{Binding ElementName=MultiplierSlider, Path=Value, StringFormat=F1}"
                     IsReadOnly="True" TextAlignment="Center" Margin="5,0,0,0"/>
        </Grid>

        <!-- 反向滚动 -->
        <CheckBox x:Name="ReverseCheckBox"
                  Content="{localization:LocalisedText CorePlugins.InertialScroll.ReverseScrollDirection}"
                  FontSize="14" Margin="0,5,0,0"
                  Checked="ReverseCheckBox_Changed"
                  Unchecked="ReverseCheckBox_Changed"/>

        <!-- 提示 -->
        <TextBlock Text="{localization:LocalisedText CorePlugins.InertialScroll.Tip}"
                   TextWrapping="Wrap"
                   FontSize="12"
                   Foreground="Gray"
                   Margin="0,15,0,0"/>

    </StackPanel>
</UserControl>
