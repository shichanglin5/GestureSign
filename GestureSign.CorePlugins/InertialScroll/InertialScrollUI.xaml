<UserControl x:Class="GestureSign.CorePlugins.InertialScroll.InertialScrollUI"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:GestureSign.CorePlugins.InertialScroll"
             xmlns:localization="clr-namespace:GestureSign.Common.Localization;assembly=GestureSign.Common"
             mc:Ignorable="d"
             d:DesignHeight="300"
             d:DesignWidth="320">
    <StackPanel Margin="10">

        <!-- 滚动方向 -->
        <TextBlock Text="{localization:LocalisedText CorePlugins.InertialScroll.ScrollDirection}" FontSize="14" Margin="0,0,0,5"/>
        <ComboBox x:Name="DirectionComboBox" FontSize="14" Margin="0,0,0,15"
                  SelectionChanged="DirectionComboBox_SelectionChanged">
            <ComboBoxItem Content="{localization:LocalisedText CorePlugins.InertialScroll.DirectionVertical}" Tag="Vertical" IsSelected="True"/>
            <ComboBoxItem Content="{localization:LocalisedText CorePlugins.InertialScroll.DirectionHorizontal}" Tag="Horizontal"/>
            <ComboBoxItem Content="{localization:LocalisedText CorePlugins.InertialScroll.DirectionBoth}" Tag="Both"/>
        </ComboBox>

        <!-- 滚动精度 (像素/滚动单位) -->
        <TextBlock Text="{localization:LocalisedText CorePlugins.InertialScroll.PixelsPerScrollUnit}" FontSize="14" Margin="0,0,0,5"/>
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="60"/>
            </Grid.ColumnDefinitions>
            <Slider x:Name="PixelsPerScrollUnitSlider"
                    Minimum="0.5" Maximum="100.0" Value="30.0"
                    TickFrequency="0.5" IsSnapToTickEnabled="True"
                    ValueChanged="Slider_ValueChanged"/>
            <TextBox Grid.Column="1"
                     Text="{Binding ElementName=PixelsPerScrollUnitSlider, Path=Value, StringFormat=F0}"
                     IsReadOnly="True" TextAlignment="Center" Margin="5,0,0,0"/>
        </Grid>

        <!-- 加速因子 -->
        <TextBlock Text="{localization:LocalisedText CorePlugins.InertialScroll.AccelerationFactor}" FontSize="14" Margin="0,0,0,5"/>
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="60"/>
            </Grid.ColumnDefinitions>
            <Slider x:Name="AccelerationSlider"
                    Minimum="0.1" Maximum="5.0" Value="1.0"
                    TickFrequency="0.1" IsSnapToTickEnabled="True"
                    ValueChanged="Slider_ValueChanged"/>
            <TextBox Grid.Column="1"
                     Text="{Binding ElementName=AccelerationSlider, Path=Value, StringFormat=F1}"
                     IsReadOnly="True" TextAlignment="Center" Margin="5,0,0,0"/>
        </Grid>

        <!-- 反向滚动 -->
        <CheckBox x:Name="ReverseCheckBox"
                  Content="{localization:LocalisedText CorePlugins.InertialScroll.ReverseScrollDirection}"
                  FontSize="14" Margin="0,5,0,0"
                  Checked="ReverseCheckBox_Changed"
                  Unchecked="ReverseCheckBox_Changed"/>

        <!-- 反向水平滚动 -->
        <CheckBox x:Name="ReverseHorizontalCheckBox"
                  Content="{localization:LocalisedText CorePlugins.InertialScroll.ReverseHorizontalScrollDirection}"
                  FontSize="14" Margin="0,5,0,0"
                  Checked="ReverseHorizontalCheckBox_Changed"
                  Unchecked="ReverseHorizontalCheckBox_Changed"/>

        <!-- 滚动抖动过滤 -->
        <TextBlock FontSize="14" Margin="0,15,0,5">
            <Run Text="{localization:LocalisedText CorePlugins.InertialScroll.MinorAxisThreshold}"/>
            <Run Text="{Binding ElementName=MinorAxisThresholdSlider, Path=Value, StringFormat=P0, Mode=OneWay}"/>
        </TextBlock>
        <Slider x:Name="MinorAxisThresholdSlider"
                Minimum="0.0" Maximum="0.8" TickFrequency="0.1"
                IsSnapToTickEnabled="True"
                ValueChanged="MinorAxisThresholdSlider_ValueChanged"
                Margin="0,0,0,5"/>
        <TextBlock FontSize="12" Foreground="Gray" Margin="0,0,0,10"
                   TextWrapping="Wrap"
                   Text="{localization:LocalisedText CorePlugins.InertialScroll.MinorAxisThresholdDescription}"/>

        <!-- WinUI/UWP 应用滚动补偿 -->
        <CheckBox x:Name="EnableWinUIDetectionCheckBox"
                  Content="{localization:LocalisedText CorePlugins.InertialScroll.EnableWinUIDetection}"
                  FontSize="14" Margin="0,15,0,5"
                  Checked="EnableWinUIDetectionCheckBox_Changed"
                  Unchecked="EnableWinUIDetectionCheckBox_Changed"
                  IsChecked="True"/>

        <TextBlock Text="{localization:LocalisedText CorePlugins.InertialScroll.WinUIScrollMultiplier}"
                   FontSize="14" Margin="0,5,0,5"/>
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="60"/>
            </Grid.ColumnDefinitions>
            <Slider x:Name="WinUIScrollMultiplierSlider"
                    Minimum="1.0" Maximum="10.0" Value="3.0"
                    TickFrequency="0.5" IsSnapToTickEnabled="True"
                    ValueChanged="Slider_ValueChanged"
                    IsEnabled="{Binding ElementName=EnableWinUIDetectionCheckBox, Path=IsChecked}"/>
            <TextBox Grid.Column="1"
                     Text="{Binding ElementName=WinUIScrollMultiplierSlider, Path=Value, StringFormat=F1}"
                     IsReadOnly="True" TextAlignment="Center" Margin="5,0,0,0"/>
        </Grid>
        <TextBlock FontSize="12" Foreground="Gray" Margin="0,0,0,10"
                   TextWrapping="Wrap"
                   Text="{localization:LocalisedText CorePlugins.InertialScroll.WinUIMultiplierDescription}"/>

        <!-- 提示 -->
        <TextBlock Text="{localization:LocalisedText CorePlugins.InertialScroll.Tip}"
                   TextWrapping="Wrap"
                   FontSize="12"
                   Foreground="Gray"
                   Margin="0,15,0,0"/>

    </StackPanel>
</UserControl>
