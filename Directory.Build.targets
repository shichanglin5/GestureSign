<Project>
  <!-- GestureSign Package Target -->
  <!-- This file defines a custom MSBuild target that packages the application after build -->

  <PropertyGroup>
    <!-- Define the package output directory -->
    <!-- uiAccessRelease 配置使用受保护目录 (C:\Program Files\)，以便 UIAccess 权限生效 -->
    <!-- 其他配置(Debug/Release/Portable/Centennial)使用开发目录 -->
    <PackageOutputDir Condition="'$(Configuration)' == 'uiAccessRelease'">C:\Program Files\GestureSign</PackageOutputDir>
    <PackageOutputDir Condition="'$(Configuration)' != 'uiAccessRelease'">D:\wd\soft\GestureSign</PackageOutputDir>
  </PropertyGroup>

  <!-- Package target - run for both Debug and Release, only for main projects -->
  <!-- Run after PostBuildEvent (which runs after _CreateAppHost) to ensure .exe files are created -->
  <Target Name="Package"
          AfterTargets="PostBuildEvent"
          Condition="'$(AssemblyName)' == 'GestureSign' OR '$(AssemblyName)' == 'GestureSignControlPanel'">

    <Message Text="========================================" Importance="high" />
    <Message Text="Packaging $(AssemblyName) [$(Configuration)] to $(PackageOutputDir)" Importance="high" />
    <Message Text="Output directory: $(OutDir)" Importance="high" />
    <Message Text="========================================" Importance="high" />

    <!-- Create output directory if it doesn't exist -->
    <MakeDir Directories="$(PackageOutputDir)"
             Condition="!Exists('$(PackageOutputDir)')"
             ContinueOnError="WarnAndContinue" />

    <!-- Copy main output files -->
    <ItemGroup>
      <MainFiles Include="$(OutDir)$(AssemblyName).exe" />
      <MainFiles Include="$(OutDir)$(AssemblyName).dll" />
      <MainFiles Include="$(OutDir)$(AssemblyName).pdb" />
      <MainFiles Include="$(OutDir)$(AssemblyName).runtimeconfig.json" />
      <MainFiles Include="$(OutDir)$(AssemblyName).deps.json" />
    </ItemGroup>

    <Copy SourceFiles="@(MainFiles)"
          DestinationFolder="$(PackageOutputDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('%(FullPath)') AND Exists('$(PackageOutputDir)')"
          ContinueOnError="WarnAndContinue" />

    <!-- Copy all dependency DLLs (excluding main assemblies but including internal projects) -->
    <ItemGroup>
      <DependencyDlls Include="$(OutDir)*.dll"
                      Exclude="$(OutDir)$(AssemblyName).dll" />
      <DependencyConfigs Include="$(OutDir)*.dll.config" />
      <!-- Also copy runtime-specific DLLs from runtimes folder if they exist -->
      <RuntimeDlls Include="$(OutDir)runtimes\**\*.dll" />
    </ItemGroup>

    <Copy SourceFiles="@(DependencyDlls)"
          DestinationFolder="$(PackageOutputDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(PackageOutputDir)')"
          ContinueOnError="WarnAndContinue" />

    <Copy SourceFiles="@(DependencyConfigs)"
          DestinationFolder="$(PackageOutputDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(PackageOutputDir)')"
          ContinueOnError="WarnAndContinue" />

    <!-- Copy runtime-specific DLLs maintaining folder structure -->
    <Copy SourceFiles="@(RuntimeDlls)"
          DestinationFolder="$(PackageOutputDir)\runtimes\%(RecursiveDir)"
          SkipUnchangedFiles="true"
          Condition="'@(RuntimeDlls)' != '' AND Exists('$(PackageOutputDir)')"
          ContinueOnError="WarnAndContinue" />

    <!-- Copy Languages directory -->
    <ItemGroup>
      <LanguageFiles Include="$(OutDir)Languages\**\*.*" />
    </ItemGroup>

    <Copy SourceFiles="@(LanguageFiles)"
          DestinationFolder="$(PackageOutputDir)\Languages\%(RecursiveDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(OutDir)Languages') AND Exists('$(PackageOutputDir)')"
          ContinueOnError="WarnAndContinue" />

    <!-- Copy Defaults directory if exists -->
    <ItemGroup>
      <DefaultFiles Include="$(OutDir)Defaults\**\*.*" />
    </ItemGroup>

    <Copy SourceFiles="@(DefaultFiles)"
          DestinationFolder="$(PackageOutputDir)\Defaults\%(RecursiveDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(OutDir)Defaults') AND Exists('$(PackageOutputDir)')"
          ContinueOnError="WarnAndContinue" />

    <!-- Copy Plugins directory if exists -->
    <ItemGroup>
      <PluginFiles Include="$(OutDir)Plugins\**\*.*" />
    </ItemGroup>

    <Copy SourceFiles="@(PluginFiles)"
          DestinationFolder="$(PackageOutputDir)\Plugins\%(RecursiveDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(OutDir)Plugins') AND Exists('$(PackageOutputDir)')"
          ContinueOnError="WarnAndContinue" />

    <!-- Copy startup script if exists -->
    <Copy SourceFiles="$(OutDir)StartGestureSign.bat"
          DestinationFolder="$(PackageOutputDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(OutDir)StartGestureSign.bat') AND Exists('$(PackageOutputDir)')"
          ContinueOnError="WarnAndContinue" />

    <Message Text="Package completed: $(PackageOutputDir)" Importance="high" Condition="Exists('$(PackageOutputDir)')" />
    <Warning Text="Package directory $(PackageOutputDir) not accessible - files not copied (requires admin for uiAccessRelease)" Condition="!Exists('$(PackageOutputDir)')" />
  </Target>

  <!-- Optional: Add a clean target to clean the package directory contents -->
  <!-- Only run for main projects to avoid cleaning wrong directory when using uiAccessRelease -->
  <!-- Clean directory contents but keep the directory itself to avoid lock issues -->
  <Target Name="CleanPackage" BeforeTargets="Clean"
          Condition="('$(AssemblyName)' == 'GestureSign' OR '$(AssemblyName)' == 'GestureSignControlPanel') AND Exists('$(PackageOutputDir)')">
    <Message Text="Cleaning package directory contents: $(PackageOutputDir)" Importance="high" />

    <!-- Collect all files in package directory -->
    <ItemGroup>
      <PackageFilesToDelete Include="$(PackageOutputDir)\*.*" />
      <PackageFilesToDelete Include="$(PackageOutputDir)\**\*.*" />
    </ItemGroup>

    <!-- Delete all files -->
    <Delete Files="@(PackageFilesToDelete)"
            ContinueOnError="WarnAndContinue" />

    <!-- Collect and remove all subdirectories (top-level only, RemoveDir is recursive) -->
    <ItemGroup>
      <PackageSubDirs Include="$(PackageOutputDir)\*\" />
    </ItemGroup>

    <RemoveDir Directories="@(PackageSubDirs)"
               ContinueOnError="WarnAndContinue" />

    <Message Text="Package directory cleaned (directory preserved)" Importance="high" />
  </Target>

</Project>
