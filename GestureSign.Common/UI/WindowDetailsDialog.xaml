<Window x:Class="GestureSign.Common.UI.WindowDetailsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:localization="clr-namespace:GestureSign.Common.Localization"
        Title="{localization:LocalisedText WindowDetails.Title}"
        Height="520"
        Width="480"
        WindowStyle="ToolWindow"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="5">
                <!-- 基本信息 -->
                <TextBlock Text="{localization:LocalisedText WindowDetails.BasicInfo}" FontWeight="Bold" FontSize="14" Margin="0,0,0,5" />

                <TextBlock Text="{localization:LocalisedText WindowSelector.WindowTitle}" Margin="0,5,0,2" />
                <TextBox x:Name="TitleTextBox" IsReadOnly="True" TextWrapping="Wrap" />

                <TextBlock Text="{localization:LocalisedText WindowSelector.ClassName}" Margin="0,5,0,2" />
                <TextBox x:Name="ClassNameTextBox" IsReadOnly="True" />

                <TextBlock Text="{localization:LocalisedText WindowSelector.Handle}" Margin="0,5,0,2" />
                <TextBox x:Name="HandleTextBox" IsReadOnly="True" />

                <!-- 进程信息 -->
                <TextBlock Text="{localization:LocalisedText WindowDetails.ProcessInfo}" FontWeight="Bold" FontSize="14" Margin="0,15,0,5" />

                <TextBlock Text="{localization:LocalisedText WindowSelector.ProcessName}" Margin="0,5,0,2" />
                <TextBox x:Name="ProcessNameTextBox" IsReadOnly="True" />

                <TextBlock Text="{localization:LocalisedText WindowDetails.ProcessId}" Margin="0,5,0,2" />
                <TextBox x:Name="ProcessIdTextBox" IsReadOnly="True" />

                <TextBlock Text="{localization:LocalisedText WindowSelector.ProcessPath}" Margin="0,5,0,2" />
                <TextBox x:Name="ProcessPathTextBox" IsReadOnly="True" TextWrapping="Wrap" />

                <TextBlock Text="AUMID" Margin="0,5,0,2" />
                <TextBox x:Name="AUMIDTextBox" IsReadOnly="True" TextWrapping="Wrap" />

                <!-- 窗口属性 -->
                <TextBlock Text="{localization:LocalisedText WindowDetails.WindowProperties}" FontWeight="Bold" FontSize="14" Margin="0,15,0,5" />

                <TextBlock Text="{localization:LocalisedText WindowDetails.WindowRect}" Margin="0,5,0,2" />
                <TextBox x:Name="WindowRectTextBox" IsReadOnly="True" />

                <TextBlock Text="{localization:LocalisedText WindowDetails.WindowStyle}" Margin="0,5,0,2" />
                <TextBox x:Name="WindowStyleTextBox" IsReadOnly="True" />

                <TextBlock Text="{localization:LocalisedText WindowDetails.ExtendedStyle}" Margin="0,5,0,2" />
                <TextBox x:Name="ExtendedStyleTextBox" IsReadOnly="True" />

                <!-- 焦点控件信息 -->
                <TextBlock Text="{localization:LocalisedText WindowDetails.FocusInfo}" FontWeight="Bold" FontSize="14" Margin="0,15,0,5" />

                <TextBlock Text="{localization:LocalisedText WindowDetails.FocusHandle}" Margin="0,5,0,2" />
                <TextBox x:Name="FocusHandleTextBox" IsReadOnly="True" />

                <TextBlock Text="{localization:LocalisedText WindowDetails.FocusClassName}" Margin="0,5,0,2" />
                <TextBox x:Name="FocusClassNameTextBox" IsReadOnly="True" />

                <TextBlock Text="{localization:LocalisedText WindowDetails.CaretHandle}" Margin="0,5,0,2" />
                <TextBox x:Name="CaretHandleTextBox" IsReadOnly="True" />

                <TextBlock Text="{localization:LocalisedText WindowDetails.IsTextInput}" Margin="0,5,0,2" />
                <TextBox x:Name="IsTextInputTextBox" IsReadOnly="True" />

                <TextBlock Text="{localization:LocalisedText WindowDetails.IsTextInputUIA}" Margin="0,5,0,2" />
                <TextBox x:Name="IsTextInputUIATextBox" IsReadOnly="True" />

                <!-- 父/所有者窗口 -->
                <TextBlock Text="{localization:LocalisedText WindowDetails.ParentInfo}" FontWeight="Bold" FontSize="14" Margin="0,15,0,5" />

                <TextBlock Text="{localization:LocalisedText WindowDetails.ParentHandle}" Margin="0,5,0,2" />
                <TextBox x:Name="ParentHandleTextBox" IsReadOnly="True" />

                <TextBlock Text="{localization:LocalisedText WindowDetails.OwnerHandle}" Margin="0,5,0,2" />
                <TextBox x:Name="OwnerHandleTextBox" IsReadOnly="True" />
            </StackPanel>
        </ScrollViewer>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button x:Name="CopyButton"
                    Content="{localization:LocalisedText WindowSelector.CopyInfo}"
                    Click="CopyButton_Click"
                    Padding="15,8"
                    Margin="0,0,10,0" />
            <Button Content="{localization:LocalisedText Common.OK}"
                    Click="OkButton_Click"
                    IsDefault="True"
                    Padding="15,8" />
        </StackPanel>
    </Grid>
</Window>
