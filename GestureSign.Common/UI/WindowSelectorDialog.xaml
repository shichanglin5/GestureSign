<Window x:Class="GestureSign.Common.UI.WindowSelectorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:localization="clr-namespace:GestureSign.Common.Localization"
        xmlns:ui="clr-namespace:GestureSign.Common.UI"
        mc:Ignorable="d"
        Title="{localization:LocalisedText WindowSelector.Title}"
        Height="550"
        Width="650"
        WindowStyle="ToolWindow"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Loaded="WindowSelectorDialog_Loaded"
        PreviewKeyDown="WindowSelectorDialog_PreviewKeyDown">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 捕获方式区域 -->
        <GroupBox Grid.Row="0" Header="{localization:LocalisedText WindowSelector.CaptureMethod}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 十字准星 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="5">
                    <ui:Crosshair x:Name="chCrosshair"
                                  Height="36"
                                  Width="36"
                                  CrosshairDragged="chCrosshair_CrosshairDragged"
                                  CrosshairDragging="chCrosshair_CrosshairDragging" />
                    <TextBlock Text="{localization:LocalisedText WindowSelector.DragToCapture}"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0" />
                </StackPanel>

                <!-- 包含子窗口复选框 -->
                <CheckBox x:Name="IncludeChildWindowsCheckBox"
                          Grid.Column="1"
                          Content="{localization:LocalisedText WindowSelector.IncludeChildWindows}"
                          VerticalAlignment="Center"
                          Margin="20,0,0,0"
                          Checked="IncludeChildWindowsCheckBox_Changed"
                          Unchecked="IncludeChildWindowsCheckBox_Changed" />

                <!-- 实时追踪按钮 -->
                <Button x:Name="TrackingButton"
                        Grid.Column="2"
                        Content="{localization:LocalisedText WindowSelector.StartTracking}"
                        Click="TrackingButton_Click"
                        Padding="15,5"
                        Margin="5" />
            </Grid>
        </GroupBox>

        <!-- 主内容区域 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="250" />
            </Grid.ColumnDefinitions>

            <!-- 窗口列表 -->
            <GroupBox Grid.Column="0" Header="{localization:LocalisedText WindowSelector.WindowList}" Margin="0,0,10,0">
                <ListView x:Name="WindowListView"
                          SelectionMode="Single"
                          SelectionChanged="WindowListView_SelectionChanged"
                          MouseDoubleClick="WindowListView_MouseDoubleClick">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="" Width="40">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Image Source="{Binding Path=Icon}"
                                               Height="24"
                                               Width="24" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{localization:LocalisedText WindowSelector.ProcessName}" Width="100">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Path=ProcessName}"
                                                   FontWeight="Bold"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{localization:LocalisedText WindowSelector.WindowTitle}" Width="200">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Path=Title}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </GroupBox>

            <!-- 窗口信息 -->
            <GroupBox Grid.Column="1" Header="{localization:LocalisedText WindowSelector.WindowInfo}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="5">
                        <TextBlock Text="{localization:LocalisedText WindowSelector.Title}" FontWeight="Bold" Margin="0,5,0,2" />
                        <TextBox x:Name="TitleTextBox" IsReadOnly="True" TextWrapping="Wrap" />

                        <TextBlock Text="{localization:LocalisedText WindowSelector.ClassName}" FontWeight="Bold" Margin="0,10,0,2" />
                        <TextBox x:Name="ClassNameTextBox" IsReadOnly="True" TextWrapping="Wrap" />

                        <TextBlock Text="{localization:LocalisedText WindowSelector.ProcessName}" FontWeight="Bold" Margin="0,10,0,2" />
                        <TextBox x:Name="ProcessNameTextBox" IsReadOnly="True" />

                        <TextBlock Text="{localization:LocalisedText WindowSelector.ProcessPath}" FontWeight="Bold" Margin="0,10,0,2" />
                        <TextBox x:Name="ProcessPathTextBox" IsReadOnly="True" TextWrapping="Wrap" />

                        <TextBlock Text="AUMID" FontWeight="Bold" Margin="0,10,0,2" />
                        <TextBox x:Name="AUMIDTextBox" IsReadOnly="True" TextWrapping="Wrap" />

                        <TextBlock Text="{localization:LocalisedText WindowSelector.Handle}" FontWeight="Bold" Margin="0,10,0,2" />
                        <TextBox x:Name="HandleTextBox" IsReadOnly="True" />
                    </StackPanel>
                </ScrollViewer>
            </GroupBox>
        </Grid>

        <!-- 追踪状态提示 -->
        <Border x:Name="TrackingStatusBorder"
                Grid.Row="2"
                Background="#FF2196F3"
                Visibility="Collapsed"
                Margin="0,10,0,0"
                Padding="10,5">
            <TextBlock x:Name="TrackingStatusText"
                       Foreground="White"
                       FontWeight="Bold"
                       HorizontalAlignment="Center" />
        </Border>

        <!-- 按钮区域 -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button x:Name="CopyButton"
                    Content="{localization:LocalisedText WindowSelector.CopyInfo}"
                    Click="CopyButton_Click"
                    Padding="15,8"
                    Margin="0,0,10,0" />
            <Button x:Name="RefreshButton"
                    Content="{localization:LocalisedText WindowSelector.Refresh}"
                    Click="RefreshButton_Click"
                    Padding="15,8"
                    Margin="0,0,10,0" />
            <Button x:Name="OkButton"
                    Content="{localization:LocalisedText Common.OK}"
                    Click="OkButton_Click"
                    IsDefault="True"
                    Padding="15,8"
                    Margin="0,0,10,0" />
            <Button x:Name="CancelButton"
                    Content="{localization:LocalisedText Common.Cancel}"
                    Click="CancelButton_Click"
                    IsCancel="True"
                    Padding="15,8" />
        </StackPanel>
    </Grid>
</Window>
